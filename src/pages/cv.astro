---
import Layout from '../layouts/Layout.astro';
import * as si from 'simple-icons';

const EMAIL = 'momurad.business@gmail.com';

const line = (d: string, size = 15) =>
  `<svg aria-hidden="true" focusable="false" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:${size}px;height:${size}px;max-width:${size}px;max-height:${size}px;flex-shrink:0;vertical-align:middle;">${d}</svg>`;

const iconPrinter = line('<path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/>', 16);
const iconArrowLeft = line('<path d="m12 19-7-7 7-7M5 12h14"/>', 16);
const iconMail = line('<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>', 15);
const iconPin = line('<path d="M12 22s7-7.58 7-13a7 7 0 1 0-14 0c0 5.42 7 13 7 13Z"/><circle cx="12" cy="9" r="2.5"/>', 15);

const skills = [
  { group: 'Languages', items: ['TypeScript', 'Swift', 'C# / .NET', 'C++', 'SQL', 'T-SQL'] },
  { group: 'Backend & Cloud', items: ['Cloudflare Workers', 'Hono', 'Node.js', 'PostgreSQL', 'Supabase', 'SQLite / D1', 'REST APIs', 'SSE / Streaming'] },
  { group: 'Systems & Tooling', items: ['Git', 'Vitest', 'Docker', 'NGINX', 'Linux (Debian)', 'Xcode', 'Property-Based Testing', 'CI/CD'] },
  { group: 'Architecture', items: ['Three-Tier Architecture', 'Append-Only Auditing', 'Event-Driven Systems', 'On-Device Core ML', 'Schema Validation'] },
];
---

<Layout
  title="Mohamed Morad — Curriculum Vitae"
  description="Curriculum Vitae of Mohamed Morad, Backend Engineer at the Apple Developer Academy, Bali. Verified numbers, architecture, and experience."
>
  <div class="cv-page">
    <div class="cv-bar no-print">
      <a href="/" class="cv-back-link">
        <Fragment set:html={iconArrowLeft} /> Back to Portfolio
      </a>
      <div class="cv-bar-actions">
        <button type="button" class="btn btn-primary glass cv-print-btn" onclick="window.print()">
          <Fragment set:html={iconPrinter} /> Print / Save as PDF
        </button>
      </div>
    </div>

    <article class="cv-sheet">
      <header class="cv-header">
        <div class="cv-title-block">
          <h1 class="cv-name">Mohamed Morad</h1>
          <p class="cv-tagline">Backend Engineer &middot; Apple Developer Academy, Bali</p>
          <p class="cv-subtagline">Specialized in correct-by-construction backend systems, edge computing &amp; verifiable AI</p>
        </div>
        <div class="cv-contact-block">
          <p class="cv-contact-row"><Fragment set:html={iconPin} /> Bali, Indonesia &middot; Open to remote or relocation (needs visa sponsorship)</p>
          <p class="cv-contact-row"><Fragment set:html={iconMail} /> <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
          <p class="cv-contact-row cv-links">
            <a href="https://morad.dev" target="_blank" rel="noopener">morad.dev</a> &middot;
            <a href="https://github.com/mo7morad" target="_blank" rel="noopener">github.com/mo7morad</a> &middot;
            <a href="https://linkedin.com/in/momorad" target="_blank" rel="noopener">linkedin.com/in/momorad</a> &middot;
            <a href="https://apps.apple.com/app/id6766072256" target="_blank" rel="noopener">Trippé on App Store</a>
          </p>
        </div>
      </header>

      <section class="cv-section">
        <h2 class="cv-heading">Profile Summary</h2>
        <p class="cv-summary">
          Backend engineer with a bias toward provable correctness. Built a 21-month self-directed foundation
          (669 commits, 25 courses, 1,329 solved problems) before shipping production software.
          Sole author of Trippé (live on App Store), engineering its Cloudflare Worker backend, Supabase database,
          and SwiftUI client with append-only price provenance constraints that discard unquoted figures at the schema layer.
          Currently building at the Apple Developer Academy, Bali (first Egyptian in the cohort).
        </p>
      </section>

      <section class="cv-section">
        <h2 class="cv-heading">Core Technical Skills</h2>
        <div class="cv-skills-grid">
          {skills.map((s) => (
            <div class="cv-skill-col">
              <h3 class="cv-skill-group">{s.group}</h3>
              <ul class="cv-skill-list">
                {s.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section class="cv-section">
        <h2 class="cv-heading">Experience &amp; Shipped Systems</h2>

        <div class="cv-entry">
          <div class="cv-entry-head">
            <div>
              <h3 class="cv-role">iOS &amp; Backend Engineer</h3>
              <p class="cv-org">Apple Developer Academy, Bali</p>
            </div>
            <span class="cv-date">Mar 2026 &ndash; Present</span>
          </div>
          <p class="cv-note">Selected from 5,000+ applicants for ~220 cohort seats. First Egyptian engineer admitted to the academy.</p>

          <div class="cv-subentry">
            <h4 class="cv-subentry-title">
              <strong>Trippé</strong> &mdash; Flagship Travel Intelligence Platform (Live on App Store)
            </h4>
            <p class="cv-subentry-desc">Sole author of backend infrastructure, data harvest pipelines, and native iOS client.</p>
            <ul class="cv-bullets">
              <li>
                <strong>Provenance as a schema constraint:</strong> Designed immutable Layer 0 PostgreSQL schema
                (<code>price_observation</code>) requiring <code>source_quote text not null</code>. Unquoted LLM extractions
                are rejected at the database level rather than managed via prompt instructions.
              </li>
              <li>
                <strong>Refusal ladder architecture:</strong> Authored zero-row fail-safe migrations (<code>revoke_*</code>)
                ensuring cities below confidence floors yield clean refusals rather than hallucinated estimates.
              </li>
              <li>
                <strong>Property-tested cost independence:</strong> Wrote suites sweeping $500&ndash;$20,000 budgets asserting
                three distinct tier outputs to mathematically prove budget inputs cannot leak into destination pricing arithmetic.
              </li>
              <li>
                <strong>Apple Private Cloud Compute (PCC):</strong> Conducted 42 measured benchmark runs on Apple Private Cloud
                Compute vs on-device Foundation Models. Uncovered silent output truncation in on-device models at 8,192 tokens,
                architecting a fail-over route to PCC with strict structural schemas preventing price generation.
              </li>
              <li>
                <strong>Production quality:</strong> 599 backend commits, 123 test files against 144 source files (~0.9:1 test ratio),
                Cloudflare Worker running on a single runtime dependency (<code>jose</code>).
              </li>
            </ul>
          </div>

          <div class="cv-subentry">
            <h4 class="cv-subentry-title">
              <strong>Sortla / ECOdyssey</strong> &mdash; Real-Time Edge Vision System (5-Person Team)
            </h4>
            <ul class="cv-bullets">
              <li>
                <strong>Belief Engine:</strong> Authored <code>BeliefEngine.swift</code> fusing raw frame-by-frame YOLOv8 Core ML
                detections using exponential half-life decay (0.8s) and hysteresis locking to prevent frame-to-frame decision flicker.
              </li>
              <li>
                <strong>Deterministic evaluation harness:</strong> Built replay bake-off suite (<code>BinDecisionEvaluation.swift</code>)
                testing 7 real-world scenarios. Proved belief engine cut false-confident misclassifications from 3/7 (legacy vote) to 1/7.
              </li>
              <li>
                <strong>PCCJudge cloud arbitration:</strong> Authored 2,122 lines across 8 Swift modules routing edge uncertainty
                to Private Cloud Compute for second-opinion verdicts with auditable verdict stores.
              </li>
            </ul>
          </div>

          <div class="cv-subentry">
            <h4 class="cv-subentry-title">
              <strong>Academy Stickies</strong> &mdash; Production Note Platform for Cohort
            </h4>
            <ul class="cv-bullets">
              <li>
                Engineered full-stack edge application serving 200+ cohort peers on Cloudflare Pages, Hono, D1 (SQLite), and R2.
              </li>
              <li>
                Implemented passwordless magic-link authentication and 9 tested schema migrations with Vitest verification.
              </li>
            </ul>
          </div>
        </div>

        <div class="cv-entry">
          <div class="cv-entry-head">
            <div>
              <h3 class="cv-role">Self-Directed Systems &amp; Backend Curriculum</h3>
              <p class="cv-org">Independent Engineering Research</p>
            </div>
            <span class="cv-date">May 2024 &ndash; Feb 2026</span>
          </div>
          <p class="cv-note">
            Twenty-one months dedicated entirely to foundational systems, algorithms, and backend architecture before framework adoption.
            Completed 25 comprehensive courses, 1,329 algorithmic problems, 18 projects, and 669 commits.
          </p>

          <div class="cv-subentry">
            <h4 class="cv-subentry-title">
              <strong>DVLD (Driving &amp; Vehicle License Department)</strong> &mdash; Architectural Capstone
            </h4>
            <ul class="cv-bullets">
              <li>
                Engineered an enterprise-scale 3-tier desktop system in C# WinForms and SQL Server comprising 28,541 lines across 134 files.
              </li>
              <li>
                Implemented data access 100% via asynchronous parameterized ADO.NET (<code>SqlCommand</code>, <code>SqlDataReader</code>)
                with dedicated DTOs, intentionally avoiding ORMs to master explicit query performance and transaction safety.
              </li>
              <li>
                Designed relational schema with 25 foreign-key constraints, mode-driven domain state (<code>enMode</code>), and role-based access control.
              </li>
            </ul>
          </div>

          <div class="cv-subentry">
            <h4 class="cv-subentry-title">
              <strong>Iterative Systems Re-engineering</strong>
            </h4>
            <ul class="cv-bullets">
              <li>
                Progressively rebuilt core banking architecture across 3 complete iterations: procedural flat-file persistence &rarr;
                multi-user role-based authentication &rarr; full OOP domain model with multi-currency exchange and immutable activity logs.
              </li>
            </ul>
          </div>
        </div>
      </section>

      <section class="cv-section">
        <h2 class="cv-heading">Education</h2>
        <div class="cv-entry">
          <div class="cv-entry-head">
            <div>
              <h3 class="cv-role">B.Sc. in Informatics (Computer Science)</h3>
              <p class="cv-org">Universitas Islam Indonesia</p>
            </div>
            <span class="cv-date">Aug 2023 &ndash; Expected Aug 2027</span>
          </div>
          <p class="cv-note">Studying full curriculum in English on competitive international merit scholarship.</p>
        </div>

        <div class="cv-entry">
          <div class="cv-entry-head">
            <div>
              <h3 class="cv-role">Engineering Resident &middot; Cohort 2026</h3>
              <p class="cv-org">Apple Developer Academy, Bali</p>
            </div>
            <span class="cv-date">Mar 2026 &ndash; Dec 2026</span>
          </div>
          <p class="cv-note">Challenge-based software engineering and product shipping program with Apple mentors.</p>
        </div>
      </section>

      <footer class="cv-footer">
        <p>Every metric on this CV is measured directly from git history and production codebases. Verifiable at <a href="https://morad.dev">morad.dev</a>.</p>
      </footer>
    </article>
  </div>
</Layout>

<style>
  .cv-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
  }

  .cv-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .cv-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--blue);
    text-decoration: none;
    font-size: var(--fs-subhead);
    font-weight: 500;
    transition: transform 200ms ease;
  }
  .cv-back-link svg {
    width: 18px;
    height: 18px;
  }
  .cv-back-link:hover {
    transform: translateX(-3px);
  }

  .cv-print-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-size: var(--fs-subhead);
    padding: 0.6rem 1.2rem;
    border-radius: var(--r-pill);
  }
  .cv-print-btn svg {
    width: 16px;
    height: 16px;
  }

  .cv-sheet {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 3.5rem 3rem;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }

  .cv-header {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 2rem;
    margin-bottom: 2rem;
  }

  .cv-name {
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.4rem;
    color: #fff;
  }

  .cv-tagline {
    font-size: 1.15rem;
    color: var(--blue);
    font-weight: 600;
    margin: 0 0 0.3rem;
  }

  .cv-subtagline {
    font-size: var(--fs-subhead);
    color: var(--text-dim);
    margin: 0 0 1.25rem;
  }

  .cv-contact-row {
    font-size: var(--fs-footnote);
    color: var(--text-dim);
    margin: 0.35rem 0;
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  :global(.cv-contact-row svg) {
    width: 15px !important;
    height: 15px !important;
    max-width: 15px !important;
    max-height: 15px !important;
    flex-shrink: 0;
    color: var(--blue);
    display: inline-block;
    vertical-align: middle;
  }
  :global(.cv-back-link svg),
  :global(.cv-print-btn svg) {
    width: 16px !important;
    height: 16px !important;
    max-width: 16px !important;
    max-height: 16px !important;
    flex-shrink: 0;
    display: inline-block;
    vertical-align: middle;
  }
  .cv-links a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cv-links a:hover {
    color: var(--blue);
  }

  .cv-section {
    margin-bottom: 2.4rem;
  }

  .cv-heading {
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--blue);
    border-bottom: 1px solid rgba(120, 160, 255, 0.2);
    padding-bottom: 0.4rem;
    margin: 0 0 1.2rem;
    font-weight: 700;
  }

  .cv-summary {
    font-size: var(--fs-subhead);
    line-height: 1.65;
    color: var(--text);
    margin: 0;
  }

  .cv-skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
  }
  @media (max-width: 600px) {
    .cv-skills-grid {
      grid-template-columns: 1fr;
    }
  }

  .cv-skill-col {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: 1rem 1.2rem;
  }

  .cv-skill-group {
    font-size: var(--fs-footnote);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--blue-soft);
    margin: 0 0 0.5rem;
    font-weight: 600;
  }

  .cv-skill-list {
    margin: 0;
    padding-left: 1.1rem;
    font-size: var(--fs-footnote);
    color: var(--text);
    line-height: 1.5;
  }

  .cv-entry {
    margin-bottom: 2rem;
  }

  .cv-entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.35rem;
  }

  .cv-role {
    font-size: 1.1rem;
    font-weight: 600;
    color: #fff;
    margin: 0;
  }

  .cv-org {
    font-size: var(--fs-subhead);
    color: var(--blue);
    margin: 0.15rem 0 0;
    font-weight: 500;
  }

  .cv-date {
    font-size: var(--fs-footnote);
    color: var(--text-dim);
    font-family: 'IBM Plex Mono', monospace;
  }

  .cv-note {
    font-size: var(--fs-footnote);
    color: var(--text-dim);
    font-style: italic;
    margin: 0.2rem 0 1rem;
  }

  .cv-subentry {
    margin-top: 1.2rem;
    padding-left: 1rem;
    border-left: 2px solid rgba(120, 160, 255, 0.25);
  }

  .cv-subentry-title {
    font-size: 0.98rem;
    color: #fff;
    margin: 0 0 0.2rem;
  }

  .cv-subentry-desc {
    font-size: var(--fs-footnote);
    color: var(--text-dim);
    margin: 0 0 0.5rem;
  }

  .cv-bullets {
    margin: 0;
    padding-left: 1.2rem;
    font-size: 0.88rem;
    color: var(--text);
    line-height: 1.55;
  }
  .cv-bullets li {
    margin-bottom: 0.45rem;
  }
  .cv-bullets code {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.82rem;
    background: rgba(255, 255, 255, 0.08);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
  }

  .cv-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 1.5rem;
    margin-top: 2rem;
    font-size: var(--fs-caption1);
    color: var(--text-dim);
    text-align: center;
  }

  /* ------------------- PRINT MEDIA STYLES ------------------- */
  @media print {
    :root {
      color-scheme: light;
    }
    body {
      background: #fff !important;
      color: #111827 !important;
      font-size: 10pt !important;
      line-height: 1.4 !important;
    }
    .no-print, .ambient, .cursor, .skip-link, nav, header.nav, footer.site {
      display: none !important;
    }
    .cv-page {
      max-width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    .cv-sheet {
      background: #fff !important;
      color: #111827 !important;
      border: none !important;
      border-radius: 0 !important;
      padding: 0 !important;
      box-shadow: none !important;
      backdrop-filter: none !important;
    }
    .cv-name {
      color: #000 !important;
      font-size: 20pt !important;
    }
    .cv-tagline {
      color: #2563eb !important;
      font-size: 11pt !important;
    }
    .cv-subtagline {
      color: #4b5563 !important;
      font-size: 9pt !important;
    }
    .cv-contact-row, .cv-contact-row svg {
      color: #4b5563 !important;
    }
    .cv-links a {
      color: #1d4ed8 !important;
      text-decoration: none !important;
    }
    .cv-heading {
      color: #1e3a8a !important;
      border-bottom: 1.5pt solid #2563eb !important;
      font-size: 11pt !important;
      margin-top: 12pt !important;
      margin-bottom: 8pt !important;
      page-break-after: avoid;
    }
    .cv-skill-col {
      background: #f9fafb !important;
      border: 0.5pt solid #e5e7eb !important;
      padding: 6pt 8pt !important;
    }
    .cv-skill-group {
      color: #1e3a8a !important;
    }
    .cv-skill-list {
      color: #1f2937 !important;
    }
    .cv-role {
      color: #111827 !important;
      font-size: 11pt !important;
    }
    .cv-org {
      color: #2563eb !important;
      font-size: 10pt !important;
    }
    .cv-date {
      color: #4b5563 !important;
      font-size: 9pt !important;
    }
    .cv-note {
      color: #6b7280 !important;
    }
    .cv-subentry {
      border-left: 2pt solid #93c5fd !important;
      padding-left: 8pt !important;
      margin-top: 8pt !important;
      page-break-inside: avoid;
    }
    .cv-subentry-title {
      color: #111827 !important;
      font-size: 10pt !important;
    }
    .cv-bullets {
      color: #374151 !important;
      font-size: 9pt !important;
    }
    .cv-bullets code {
      background: #f3f4f6 !important;
      color: #111827 !important;
      border: 0.5pt solid #e5e7eb;
    }
    .cv-footer {
      border-top: 0.5pt solid #e5e7eb !important;
      color: #6b7280 !important;
      font-size: 8pt !important;
      margin-top: 15pt !important;
    }
    .cv-entry {
      page-break-inside: avoid;
    }
  }
</style>
