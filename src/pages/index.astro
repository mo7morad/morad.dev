---
import Layout from '../layouts/Layout.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
import * as si from 'simple-icons';

// Decorative by default. Every call site on this page either sits directly
// beside visible text saying the same word (.tile "TypeScript TypeScript",
// .pill, .rack li) or lives inside an anchor that already carries an
// aria-label — so a named mark made a screen reader announce all sixteen
// stack technologies twice. Pass `label` only where nothing visible names it.
function brandIcon(icon: { hex: string; path: string; title: string }, color?: string, label?: string) {
  const a = label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"';
  return `<svg ${a} viewBox="0 0 24 24" fill="${color ?? `#${icon.hex}`}" xmlns="http://www.w3.org/2000/svg"><path d="${icon.path}"/></svg>`;
}

// Brand marks whose official color is near-black and would vanish on this ground.
const LIGHT = '#e5e7eb';

const EMAIL = 'momurad.business@gmail.com';

// Same reasoning as brandIcon: every line glyph on this page is paired with a
// visible label or sits inside a labelled control, so none of them should be
// announced on their own.
const line = (d: string) =>
  `<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;

const iconTerminal = line('<rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 9 3 3-3 3M13 15h4"/>');
const iconDatabase = line('<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>');
const iconWrench = line('<path d="M14.7 6.3a4 4 0 0 0 5 5L15 16l-4-4Z"/><path d="m11 12-7 7a1.8 1.8 0 0 0 2.5 2.5l7-7"/>');
const iconPin = line('<path d="M12 22s7-7.58 7-13a7 7 0 1 0-14 0c0 5.42 7 13 7 13Z"/><circle cx="12" cy="9" r="2.5"/>');
const iconMail = line('<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>');
const iconCopy = line('<rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/>');
const iconCheck = line('<path d="m5 13 4 4L19 7"/>');
const iconExternal = line('<path d="M7 17 17 7M9 7h8v8"/>');
const iconExpand = line('<path d="M15 3h6v6M21 3l-7 7M9 21H3v-6M3 21l7-7"/>');
const iconChevronL = line('<path d="m15 18-6-6 6-6"/>');
const iconChevronR = line('<path d="m9 6 6 6-6 6"/>');
const iconClose = line('<path d="M18 6 6 18M6 6l12 12"/>');
const iconBriefcase = line('<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18"/>');
const iconAward = line('<circle cx="12" cy="8" r="6"/><path d="M8.2 13.2 7 22l5-2.9 5 2.9-1.2-8.8"/>');
const iconChip = line('<rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/>');
const iconBrackets = line('<path d="m8 6-6 6 6 6M16 6l6 6-6 6"/>');
const iconMailOpen = line('<path d="M3 9.5 12 4l9 5.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="m3 9.5 9 6 9-6"/>');
const iconLinkedin = `<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><rect x="1" y="1" width="22" height="22" rx="4" fill="#0A66C2"/><path fill="#fff" d="M7.4 9.7h2.55v7.9H7.4zm1.28-1.1a1.48 1.48 0 1 1 0-2.96 1.48 1.48 0 0 1 0 2.96zm3.1 1.1h2.44v1.08h.03c.34-.64 1.17-1.32 2.41-1.32 2.58 0 3.06 1.7 3.06 3.9v4.24h-2.55v-3.76c0-.9-.02-2.05-1.25-2.05-1.25 0-1.44.98-1.44 1.98v3.83h-2.55z"/></svg>`;

// Every tile: a real simple-icons mark, used exactly once, naming something
// that appears in a shipped repo.
const stackGroups = [
  {
    label: 'Languages',
    icon: iconTerminal,
    items: [
      { icon: si.siTypescript, label: 'TypeScript' },
      { icon: si.siSwift, label: 'Swift' },
      { icon: si.siDotnet, label: 'C# / .NET' },
      { icon: si.siCplusplus, label: 'C++' },
    ],
  },
  {
    label: 'Backend & Data',
    icon: iconDatabase,
    items: [
      { icon: si.siCloudflareworkers, label: 'Workers' },
      { icon: si.siNodedotjs, label: 'Node.js' },
      { icon: si.siHono, label: 'Hono' },
      { icon: si.siPostgresql, label: 'PostgreSQL' },
      { icon: si.siSupabase, label: 'Supabase' },
      { icon: si.siSqlite, label: 'SQLite / D1' },
    ],
  },
  {
    label: 'Tooling & Infrastructure',
    icon: iconWrench,
    items: [
      { icon: si.siGit, label: 'Git' },
      { icon: si.siGithub, label: 'GitHub', color: LIGHT },
      { icon: si.siVitest, label: 'Vitest' },
      { icon: si.siXcode, label: 'Xcode' },
      { icon: si.siDebian, label: 'Debian' },
      { icon: si.siNginx, label: 'NGINX' },
    ],
  },
];

// Real brand marks, not generic line icons — these are the services themselves,
// and a laptop/shield/funnel glyph named none of them.
const homelab = [
  { icon: si.siDebian, title: 'Headless Debian', note: 'Repurposed laptop, driven over SSH' },
  { icon: si.siNginx, title: 'NGINX reverse proxy', note: 'TLS terminated and configured by hand' },
  { icon: si.siPihole, title: 'Pi-hole DNS', note: 'Filtering for every device, not one browser' },
  { icon: si.siImmich, title: 'Immich photo library', note: 'Photos on disks I actually hold' },
];

// Dates are the ones printed on the scans themselves, not the order they were
// added here — the tile makes a claim, the scan behind it is the source.
const certificates = [
  { src: '/images/certificates/cert-10.webp', n: '10', title: 'Object-Oriented Programming', date: 'Dec 2024' },
  { src: '/images/certificates/cert-18.webp', n: '18', title: 'C# & SQL Connectivity', date: 'Apr 2025' },
  { src: '/images/certificates/cert-19.webp', n: '19', title: 'DVLD Capstone Project', date: 'Jun 2025' },
  { src: '/images/certificates/cert-21.webp', n: '21', title: 'T-SQL', date: 'Aug 2025' },
  { src: '/images/certificates/cert-23.webp', n: '23', title: 'Algorithms — Level 6', date: 'Feb 2026' },
  { src: '/images/certificates/cert-25.webp', n: '25', title: 'SOLID Principles', date: 'Oct 2025' },
];

// One source for both places a contact method appears: the always-visible
// directory in the contact card, and the sheet the "Contact me" button opens.
// Two hand-written lists drift; two renderings of one array can't.
const contactMethods = [
  {
    key: 'email',
    label: 'Email',
    detail: EMAIL,
    href: `mailto:${EMAIL}`,
    icon: iconMail,
    external: false,
  },
  {
    key: 'github',
    label: 'GitHub',
    detail: '@mo7morad',
    href: 'https://github.com/mo7morad',
    // #181717 is near-black on this ground — the same reason the GitHub stack
    // tile is forced to LIGHT.
    icon: brandIcon(si.siGithub, LIGHT),
    external: true,
  },
  {
    key: 'linkedin',
    label: 'LinkedIn',
    detail: 'in/momorad',
    href: 'https://www.linkedin.com/in/momorad',
    // simple-icons v16 dropped siLinkedin; this is the hand-authored mark.
    icon: iconLinkedin,
    external: true,
  },
  {
    key: 'appstore',
    label: 'Trippé',
    detail: 'Live on the App Store',
    href: 'https://apps.apple.com/app/id6766072256',
    icon: brandIcon(si.siAppstore),
    external: true,
  },
];

// Authored in document order on purpose: the nav carries a travelling dot, and a
// position indicator over a list that doesn't match the page order runs backwards
// as you scroll.
const navLinks = [
  { label: 'About', href: '#top', spy: '.hero' },
  { label: 'Experience', href: '#experience' },
  { label: 'Stack', href: '#stack' },
  { label: 'Work', href: '#projects' },
  { label: 'Contact', href: '#contact' },
];
---

<Layout
  title="Mohamed Morad — Backend Engineer"
  description="Backend engineer at the Apple Developer Academy, Bali. I build systems that refuse to state what they cannot prove — starting with Trippé, on the App Store."
  ogDescription="Backend engineer at the Apple Developer Academy, Bali. I build systems that refuse to state what they cannot prove — starting with Trippé, whose backend discards any price it cannot trace to a quoted source."
>
  <a href="#top" class="skip-link">Skip to content</a>

  <div id="intro" class="intro" aria-hidden="true">
    <p class="intro-line mono"><span class="intro-text"></span><span class="intro-caret"></span></p>
  </div>

  <div class="ambient" aria-hidden="true">
    <span class="b1"></span><span class="b2"></span><span class="b3"></span><span class="b4"></span>
    <span class="cursor-glow"></span>
  </div>

  <div class="cursor" aria-hidden="true">
    <span class="cursor-dot"><span class="cursor-dot-shape"></span></span>
  </div>

  <header class="nav glass">
    <div class="wrap nav-inner">
      {/* The name lives on the anchor, not on the span. `.brand span` is
          display:none from 820px down while `.brand` itself only hides at
          560px, so in that 260px band — a landscape tablet, a half-width
          laptop window — the link was visible, focusable, and announced as
          "link" with no destination: its only content was an alt="" image. */}
      <a href="#top" class="brand" aria-label="Mohamed Morad — back to top" data-scroll-to>
        <img src="/images/profile-avatar.webp" alt="" width="26" height="26" />
        <span>morad</span>
      </a>
      <nav class="nav-links" aria-label="Sections">
        <span class="nav-indicator" aria-hidden="true"></span>
        {navLinks.map((l) => (
          <a href={l.href} class="nav-link" data-scroll-to data-spy={l.spy ?? l.href}>{l.label}</a>
        ))}
      </nav>
    </div>
  </header>

  {/* tabindex="-1" so the skip link moves real focus into the landmark and a
      screen reader announces "main" on arrival, rather than leaving the virtual
      cursor where it was. Paired with main:focus{outline:none} in the CSS. */}
  <main id="top" tabindex="-1">
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-photo-col" data-intro-reveal>
          <div class="hero-photo">
            {/* The only eager image on the page and the one competing for LCP
                on desktop, where it measured within 2.4% of the hero
                paragraph. Everything else is loading="lazy". */}
            <img src="/images/profile-avatar.webp" alt="Mohamed Morad" width="168" height="168" fetchpriority="high" />
          </div>
          <p class="hero-loc"><Fragment set:html={iconPin} />Bali, Indonesia</p>
          <div class="hero-social">
            <a href="https://github.com/mo7morad" target="_blank" rel="noopener" aria-label="GitHub" set:html={brandIcon(si.siGithub, LIGHT)} />
            <a href="https://www.linkedin.com/in/momorad" target="_blank" rel="noopener" aria-label="LinkedIn" set:html={iconLinkedin} />
            <a href="https://apps.apple.com/app/id6766072256" target="_blank" rel="noopener" aria-label="Trippé on the App Store" set:html={brandIcon(si.siAppstore)} />
            <a href={`mailto:${EMAIL}`} aria-label="Email" set:html={iconMail} />
          </div>
        </div>
        <div>
          <h1 class="hero-name" data-intro-reveal>Mohamed Morad</h1>
          {/* Title and stack share one line: the title is what a hiring manager
              scans for, the stack is its tail, and on one line the stack is
              never read as list item one. */}
          <p class="hero-role" data-intro-reveal><b>Backend Engineer</b> &middot; C# / .NET &middot; TypeScript &middot; SQL &middot; Cloudflare Workers</p>
          {/* The page's actual claim, in the page's actual words. It used to be
              last, at --fs-callout in --text-dim — one step SMALLER and no
              brighter than the three paragraphs that evidence it — and it was
              also worded differently from the line the intro overlay types and
              from the share preview. Three renderings of one idea, and the two
              that agreed were the two a visitor saw least. */}
          <p class="hero-thesis" data-intro-reveal>I build systems that refuse to state what they cannot prove.</p>
          {/* Headless on purpose — "I build" opened three of the four blocks
              here, and this one sits two lines under a thesis that already
              says it. */}
          <p class="hero-bio" data-intro-reveal>Backend systems and AI-powered products, built with a bias toward correctness.</p>
          <p class="hero-bio" data-intro-reveal>The clearest example is Trippé, a travel app on the App Store: its backend refuses to show a price it cannot trace to a source. I built that backend, the iOS client, and the cost engine myself.</p>
          <div class="hero-cta" data-intro-reveal>
            {/* Stays an anchor, not a button: with no JS this is still a
                working mailto. The script intercepts the click and opens the
                sheet instead, and only then adds the popup ARIA — so the
                attributes never promise a dialog that can't open. */}
            <a href={`mailto:${EMAIL}`} class="btn btn-primary glass glass-interactive" data-contact-open set:html={`${iconMail}Contact me`} />
            <a href="#projects" class="btn btn-quiet" data-scroll-to>View my work</a>
          </div>
        </div>
      </div>
    </section>

    <section id="experience">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <span class="section-badge" set:html={iconBriefcase} />
          <h2 class="section-title" style="--grad-end:var(--cyan)">Experience &amp; Journey</h2>
        </div>

        <ol class="exp" role="list">
          <li class="exp-item" data-reveal>
            <span class="exp-marker" aria-hidden="true"></span>
            <div class="exp-head">
              <p class="exp-date">Mar 2026 &ndash; Present</p>
              <h3>Apple Developer Academy, Bali</h3>
              <p class="exp-role">iOS &amp; Backend Engineer &middot; Cohort 2026</p>
            </div>
            <p>A challenge-based engineering program where I build and ship products in short development cycles, from prototype to production.</p>
            <p>I&rsquo;ve worked across backend systems, iOS, on-device AI, testing, and product delivery. Trippé, Numo, Sortla, and Academy Stickies all came from this period.</p>
            <p class="exp-role">220 places &middot; 5,000+ applicants &middot; first Egyptian in the cohort</p>
          </li>

          <li class="exp-item" data-reveal>
            <span class="exp-marker" aria-hidden="true"></span>
            <div class="exp-head">
              <p class="exp-date">May 2024 &ndash; Feb 2026</p>
              <h3>Backend Fundamentals Roadmap</h3>
              <p class="exp-role">Self-directed curriculum</p>
            </div>
            <p>Twenty-one months spent building the fundamentals before worrying about frameworks.</p>
            <p>25 courses &middot; 1,329 solved problems &middot; 18 projects &middot; 669 commits</p>
            <p>C++, algorithms, OOP, data structures, C#, SQL, T-SQL, REST APIs, SOLID, testing, and database design.</p>
            <p>The curriculum ended with DVLD, a 28,541-line three-tier C# and SQL Server system.</p>
          </li>

          <li class="exp-item" data-reveal>
            <span class="exp-marker" aria-hidden="true"></span>
            <div class="exp-head">
              <p class="exp-date">Aug 2023</p>
              <h3>Universitas Islam Indonesia</h3>
                <p class="exp-role">B.Sc. Informatics (Computer Science)</p>
            </div>
              <p>Studying Informatics in Indonesia on scholarship while building and shipping software alongside the degree.</p>
          </li>

          <li class="exp-item" data-reveal>
            <span class="exp-marker" aria-hidden="true"></span>
            <div class="exp-head">
              <p class="exp-date">2023</p>
              <h3>First lines of code</h3>
              <p class="exp-role">Egypt</p>
            </div>
            <p>CS50 was my starting point.</p>
            <p>My first project was a Python/Tkinter download manager. I lost the source because I had no Git and no backup.</p>
            <p><code class="mono">git init</code> has been the first command on every project since.</p>
          </li>
        </ol>

        <div class="certs" data-reveal>
          <h3 class="subhead"><span class="subhead-icon" set:html={iconAward} />Certified coursework</h3>
          <p class="subhead-note">Six of the 25 certificates I earned across the ProgrammingAdvices backend curriculum &mdash; open any one to read the scan.</p>
          <div class="cert-grid">
            {certificates.map((c, i) => (
              <button
                type="button"
                class="cert"
                data-cert={i}
                data-src={c.src}
                data-n={c.n}
                data-title={c.title}
                data-date={c.date}
                aria-label={`View certificate ${c.n}, ${c.title}, ${c.date}, full size`}
              >
                <span class="cert-shot">
                  <img src={c.src} alt="" loading="lazy" width="800" height="565" />
                  <span class="cert-seal" aria-hidden="true"><Fragment set:html={iconAward} />Certificate <b class="num">{c.n}</b></span>
                  <span class="cert-zoom" aria-hidden="true"><Fragment set:html={iconExpand} /></span>
                </span>
                <span class="cert-cap">
                  <span class="cert-title">{c.title}</span>
                  <span class="cert-date num">{c.date}</span>
                </span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="stack">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <span class="section-badge" set:html={iconChip} />
          <h2 class="section-title" style="--grad-end:var(--blue)">My Tech Stack</h2>
        </div>
        <p class="section-intro" data-reveal>Tools I work in, not a list of everything I have touched.</p>
        {stackGroups.map((g) => (
          <div class="stack-group" data-reveal>
            <h3 class="subhead"><span class="subhead-icon" set:html={g.icon} />{g.label}</h3>
            <div class="stack-grid">
              {g.items.map((t) => (
                <div class="tile" style={`--brand:#${t.icon.hex}`}>
                  <Fragment set:html={brandIcon(t.icon, t.color)} />
                  <span>{t.label}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="projects">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <span class="section-badge" set:html={iconBrackets} />
          <h2 class="section-title" style="--grad-end:var(--cyan)">Selected Work</h2>
        </div>
        <p class="section-intro" data-reveal>Six projects. Three are running in production; every figure below is counted from the repository it describes.</p>

        <div class="project-list">
          <article class="project-card glass glass-interactive" data-reveal>
            <div class="project-visual">
              <PhoneMockup size="sm" src="/images/trippe/destination-sao-miguel.webp" alt="Trippé destination screen for São Miguel, Azores." />
              <PhoneMockup size="sm" src="/images/trippe/estimated-spending.webp" alt="Trippé estimated cost breakdown screen." />
            </div>
            <div class="project-body">
              <h3>Trippé</h3>
              <p class="project-meta">Solo &middot; Backend, iOS &amp; cost engine &middot; App Store</p>
              <p>A travel app that recommends destinations and builds a realistic trip cost from sourced data.</p>
              <p>The important constraint is simple: a price without a traceable source never reaches the user.</p>
              <p>I designed and built the Cloudflare Worker backend, SwiftUI client, and cost engine, including the data pipeline, streaming recommendation flow, and AI integration.</p>
              <ul class="facts" role="list">
                <li><b>599</b> backend commits</li>
                <li><b>250</b> iOS commits</li>
                <li><b>123</b> backend test files</li>
              </ul>
              <div class="project-stack">
                <span class="pill"><Fragment set:html={brandIcon(si.siCloudflare)} />Cloudflare</span>
                <span class="pill"><Fragment set:html={brandIcon(si.siTypescript)} />TypeScript</span>
                <span class="pill"><Fragment set:html={brandIcon(si.siSwift)} />Swift</span>
              </div>
              <div class="project-links">
                <a href="https://apps.apple.com/app/id6766072256" class="btn btn-primary glass glass-interactive" target="_blank" rel="noopener" set:html={`View on the App Store${iconExternal}`} />
              </div>
            </div>
          </article>

          <article class="project-card glass glass-interactive" data-reveal>
            <div class="project-visual">
              <figure class="diagram-frame">
                <img src="/images/dvld/db-diagram.webp" width="1600" height="1160" alt="The DVLD database schema diagram: tables for People, Users, Drivers, Applications, Licenses, Tests and TestAppointments among others, with foreign-key relationships drawn between them." loading="lazy" />
              </figure>
            </div>
            <div class="project-body">
              <h3>DVLD &mdash; Driving License System</h3>
              <p class="project-meta">Solo &middot; C# / .NET &middot; SQL Server</p>
              <p>The capstone of my 21-month backend curriculum.</p>
              <p>A three-tier desktop system built with C# WinForms and SQL Server. I implemented the data-access layer with parameterised ADO.NET rather than an ORM so database interaction stayed explicit and inspectable.</p>
              <p>It was the largest system I had built at the time.</p>
              <ul class="facts" role="list">
                <li><b>28,541</b> lines</li>
                <li><b>134</b> files</li>
                <li><b>25</b> foreign-key constraints</li>
              </ul>
              <div class="project-stack">
                <span class="pill"><Fragment set:html={brandIcon(si.siDotnet)} />C# / .NET</span>
                <span class="pill"><Fragment set:html={brandIcon(si.siGit)} />Git</span>
              </div>
            </div>
          </article>

          <article class="project-card glass glass-interactive" data-reveal>
            <div class="project-visual">
              <div class="compare">
                <p class="compare-title">Seven fixed scenarios, replayed through both</p>
                <div class="bar-row">
                  <span class="bar-label">Legacy confidence vote<b>3 / 7</b></span>
                  <div class="bar-track"><div class="bar-fill legacy" style="--target-width:43%"></div></div>
                </div>
                <div class="bar-row">
                  <span class="bar-label">Belief engine (mine)<b>1 / 7</b></span>
                  <div class="bar-track"><div class="bar-fill belief" style="--target-width:14%"></div></div>
                </div>
                <p class="compare-note">Lower is better &mdash; confidently wrong calls</p>
              </div>
            </div>
            <div class="project-body">
              <h3>Sortla</h3>
              <p class="project-meta">5-person team &middot; My role: belief engine, PCC judge &amp; evaluation</p>
              <p>A waste-sorting system using on-device YOLOv8 through Core ML.</p>
              <p>I built the belief engine that turns noisy frame-by-frame detections into stable decisions, added a Private Cloud Compute second-opinion path, and built the evaluation harness used to compare the new approach with the existing one.</p>
              <p>The harness found a real bug. That was the point.</p>
              <div class="project-stack">
                <span class="pill"><Fragment set:html={brandIcon(si.siSwift)} />Swift</span>
                <span class="pill"><Fragment set:html={brandIcon(si.siApple, LIGHT)} />Core ML</span>
              </div>
            </div>
          </article>

          <article class="project-card glass glass-interactive" data-reveal>
            <div class="project-visual">
              <PhoneMockup size="sm" src="/images/stickies/gate.webp" alt="Academy Stickies sign-in gate, a live production screenshot." />
            </div>
            <div class="project-body">
              <h3>Academy Stickies</h3>
              <p class="project-meta">Solo &middot; Full-stack &middot; Live</p>
              <p>A private note wall I built for my Academy cohort and still run today.</p>
