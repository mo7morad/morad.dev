    <section id="contact">
      <div class="wrap">
        <div class="cta glass" data-reveal>
          <span class="section-badge" set:html={iconMailOpen} />
          <h2 class="section-title" style="--grad-end:var(--blue)">Looking for the next system to build.</h2>
          <p>Backend, platform, or AI-product engineering &mdash; remote or relocation.</p>
          {/* The &nbsp; hold each month to its year across a line break. */}
          <p>The Apple Developer Academy in Bali runs to December&nbsp;2026 and my Informatics degree finishes in August&nbsp;2027. Conversations are open now.</p>
          {/* The directory itself, not a button that leads to one — this is the
              destination, so the four ways to reach me are spelled out rather
              than folded behind a control. The sheet the hero button opens
              renders the same array. */}
          <ul class="clinks" role="list">
            {contactMethods.map((m) => (
              <li class:list={['clink-row', { 'is-primary': m.key === 'email' }]}>
                <a
                  class="clink"
                  href={m.href}
                  {...(m.external ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  <span class="clink-icon" aria-hidden="true" set:html={m.icon} />
                  <span class="clink-text">
                    <span class="clink-label">{m.label}</span>
                    <span class="clink-detail">{m.detail}</span>
                  </span>
                  {m.external && <span class="clink-go" aria-hidden="true" set:html={iconExternal} />}
                </a>
                {/* Every row ends in exactly one trailing glyph. For the three
                    external rows it is an affordance (this opens elsewhere);
                    for email it is an actual control, because forcing a mail
                    client open is the thing people don't want. */}
                {!m.external && (
                  <Fragment>
                    <button type="button" class="clink-copy copy-email" data-copy={EMAIL} aria-label="Copy email address">
                      <span class="copy-icon" aria-hidden="true" set:html={`${iconCopy}${iconCheck}`} />
                    </button>
                    {/* The status is a SIBLING of the button, not its content. Inside it, this
                        node was the button's only name source (.copy-icon is aria-hidden), so
                        the accessible name flipped to "Copied" for 1800ms — anyone tabbing to
                        it in that window heard "Copied, button" and no statement of what it
                        does. Splitting them also avoids the name-change vs live-region
                        double-announcement that varies across NVDA/JAWS/VoiceOver. */}
                    <span class="copy-label vis-hidden" role="status"></span>
