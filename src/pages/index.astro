  </main>

  {/* Outside <main> on purpose. A <footer> that descends from main/article/
      aside/section maps to `generic`, not `contentinfo` — so nested inside
      <main id="top"> this page exposed no contentinfo landmark at all, and the
      thesis line below sat in an unlabelled div that landmark navigation
      (VoiceOver rotor, NVDA's D key) could not reach. axe doesn't flag it,
      because the content technically is inside main. */}
  <footer class="site">
    <div class="wrap">
      {/* The four links moved up into the contact card, where they are the
          content rather than an afterthought. Repeating them here would make
          the same four destinations appear twice within one screen. */}
      <div class="footer-bottom">
        <span>&copy; {new Date().getFullYear()} Mohamed Morad</span>
        <span>Every project figure here is counted from the repository it describes, not typed by hand.</span>
      </div>
    </div>
  </footer>

  {/* Hover preview. Decorative and pointer-transparent: everything in it is
      reachable through the tile's own button and the viewer below, so it is
      hidden from assistive tech rather than announced twice. No src until a
      tile is hovered — an empty src="" refetches the document as an image. */}
  <div id="certpop" class="certpop" aria-hidden="true" hidden>
    <div class="certpop-frame">
      {/* Every scan is the same template — same header, same name, same layout,
          one course line different — so the number is the only thing that
          actually distinguishes them. At caption size it was too small to
          register while the panel was gliding; up here it is the one element
          that visibly changes on a swap. */}
      <span id="certpop-badge" class="certpop-badge num" aria-hidden="true"></span>
      <img id="certpop-img" class="certpop-img" alt="" />
      <div class="certpop-cap">
        <b id="certpop-n" class="num"></b>
        <span id="certpop-title"></span>
        <span id="certpop-date" class="cap-date num"></span>
        <span class="certpop-hint">Click to open full size</span>
      </div>
    </div>
  </div>

  <div id="certview" class="certview" role="dialog" aria-modal="true" aria-label="Certificate viewer" hidden>
    <div class="certview-scrim" data-certview-dismiss></div>
    <div class="certview-panel">
      <figure class="certview-fig">
        {/* No src until opened — an empty src="" resolves to the page URL and
            makes the browser fetch the document as an image. */}
        <img id="certview-img" alt="" width="800" height="565" />
        <figcaption class="certview-cap" role="status">
          <b id="certview-n" class="num"></b>
          <span id="certview-title"></span>
          <span id="certview-date" class="cap-date num"></span>
          <span class="certview-count"><span id="certview-pos"></span> of {certificates.length}</span>
        </figcaption>
      </figure>
      <button type="button" class="certview-btn certview-prev" aria-label="Previous certificate"><Fragment set:html={iconChevronL} /></button>
      <button type="button" class="certview-btn certview-next" aria-label="Next certificate"><Fragment set:html={iconChevronR} /></button>
      <button type="button" class="certview-btn certview-close" aria-label="Close" data-certview-dismiss><Fragment set:html={iconClose} /></button>
    </div>
  </div>

  {/* Two presentations of one dialog, the way Apple splits regular and compact
      width: a pull-down popover anchored under the button on a pointer device,
      a bottom sheet with a grabber and a Cancel bar on a phone. Same markup,
      same rows as the contact card — only the placement and the dismiss
      control change. JS sets .is-sheet; the CSS defaults to the sheet so a
      script that never measures still renders something coherent. */}
  <div id="contactsheet" class="csheet" role="dialog" aria-modal="true" aria-labelledby="csheet-title" hidden>
    <div class="csheet-scrim" data-csheet-dismiss></div>
    <div class="csheet-panel">
      <span class="csheet-grabber" aria-hidden="true"></span>
      <div class="csheet-head">
        <h2 id="csheet-title">Get in touch</h2>
        <p>Any of these reach me. Email is the one I answer fastest.</p>
      </div>
      <button type="button" class="csheet-x" aria-label="Close" data-csheet-dismiss><Fragment set:html={iconClose} /></button>
      <ul class="csheet-list" role="list">
        {contactMethods.map((m) => (
          <li class:list={['clink-row', { 'is-primary': m.key === 'email' }]}>
            <a
              class="clink"
              href={m.href}
              {...(m.external ? { target: '_blank', rel: 'noopener' } : {})}
            >
              <span class="clink-icon" aria-hidden="true" set:html={m.icon} />
              <span class="clink-text">
                <span class="clink-label">{m.label}</span>
                <span class="clink-detail">{m.detail}</span>
              </span>
              {m.external && <span class="clink-go" aria-hidden="true" set:html={iconExternal} />}
            </a>
            {!m.external && (
              <Fragment>
                <button type="button" class="clink-copy copy-email" data-copy={EMAIL} aria-label="Copy email address">
                  <span class="copy-icon" aria-hidden="true" set:html={`${iconCopy}${iconCheck}`} />
                </button>
                {/* The status is a SIBLING of the button, not its content. Inside it, this
                    node was the button's only name source (.copy-icon is aria-hidden), so
                    the accessible name flipped to "Copied" for 1800ms — anyone tabbing to
                    it in that window heard "Copied, button" and no statement of what it
                    does. Splitting them also avoids the name-change vs live-region
                    double-announcement that varies across NVDA/JAWS/VoiceOver. */}
                <span class="copy-label vis-hidden" role="status"></span>
              </Fragment>
            )}
          </li>
        ))}
      </ul>
      <button type="button" class="csheet-cancel" data-csheet-dismiss>Cancel</button>
    </div>
  </div>

  <script>
    import Lenis from 'lenis';

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fineHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    // Plays once per tab, never under reduced motion. The decision itself is
    // made by the inline head script before first paint — this script only
    // carries it out, because by the time a module runs the hero has long since
    // been painted and hiding it here is what made the page visibly un-paint
    // itself on a slow connection.
    const root = document.documentElement;
    const introEl = document.getElementById('intro');
    if (introEl) {
      const introTargets = Array.from(document.querySelectorAll<HTMLElement>('[data-intro-reveal]'));
      // Read the answer off <html> rather than re-deriving it: re-reading
      // sessionStorage here could disagree with what the page already painted.
      const playing = root.classList.contains('intro-play');
      try {
        if (playing) sessionStorage.setItem('introSeen', '1');
      } catch {
        /* private mode — the intro simply replays next load */
      }

      if (!playing) {
        introEl.remove();
      } else {
        const textEl = introEl.querySelector('.intro-text') as HTMLElement | null;
        const line = 'refuses to state what it cannot prove';
        let i = 0;
        let revealed = false;

        const reveal = () => {
          if (revealed) return;
          revealed = true;
          introEl.classList.add('is-leaving');
          introTargets.forEach((el, idx) => {
            setTimeout(() => el.classList.add('intro-shown'), idx * 80);
          });
          setTimeout(() => {
            introEl.remove();
            // Must come off, or the :root.intro-play rule keeps hiding any
            // [data-intro-reveal] that never received .intro-shown.
            root.classList.remove('intro-play');
          }, 700);
        };
        // Hard ceiling so a stalled type loop can never leave the overlay stuck.
        const safety = setTimeout(reveal, 4000);
        const skip = () => {
          clearTimeout(safety);
          reveal();
        };
        introEl.addEventListener('click', skip, { once: true });
        window.addEventListener('keydown', skip, { once: true });

        const type = () => {
          if (textEl && i <= line.length) {
            textEl.textContent = line.slice(0, i);
            i++;
            setTimeout(type, 32);
          } else {
            clearTimeout(safety);
            setTimeout(reveal, 350);
          }
        };
        setTimeout(type, 260);
      }
    }

    // Hoisted so anchor clicks ride the same rAF loop as wheel scroll.
    let lenis: any = null;
    if (!reduced) {
      lenis = new Lenis({ duration: 1.05, smoothWheel: true });
      const raf = (time: number) => {
        lenis.raf(time);
        requestAnimationFrame(raf);
      };
      requestAnimationFrame(raf);
    }

    document.querySelectorAll('[data-scroll-to]').forEach((a) => {
      a.addEventListener('click', (e) => {
        const id = a.getAttribute('href');
        const target = id && document.querySelector(id);
        if (!target) return;
        e.preventDefault();
        // Both paths take the nav offset from the section's own scroll-margin-top:
        // Lenis honours it, and scrollIntoView applies it natively. Passing an
        // explicit offset here as well stacked the two and landed every target
        // 168px down — past the scroll-spy's 110px scan line, so clicking a link
        // scrolled correctly but left the *previous* link lit.
        if (lenis) {
          lenis.scrollTo(target as HTMLElement);
        } else {
          target.scrollIntoView({ behavior: 'auto', block: 'start' });
        }
      });
    });

    // Hover state is read off the live event target with .closest() rather than
    // enter/leave listeners, so a nested link inside a card can't drop it.
    const cursorEl = document.querySelector('.cursor') as HTMLElement | null;
    if (cursorEl && fineHover && !reduced) {
      document.documentElement.classList.add('has-custom-cursor');
      const dot = cursorEl.querySelector('.cursor-dot') as HTMLElement;
      // The glow is a sibling of the ambient blobs, not a child of .cursor, so it
      // renders behind the page's content instead of on top of it.
      const glow = document.querySelector('.cursor-glow') as HTMLElement | null;
      let mx = 0, my = 0, cx = 0, cy = 0, gx = 0, gy = 0, primed = false;

      // One loop drives both: the dot at 0.4 stays under the hand, the glow at
      // 0.09 arrives a beat later, so the light reads as trailing the pointer.
      const tick = () => {
        // Both lerps converge asymptotically and never arrive, so without a
        // floor this wrote two transforms every frame forever on any pointer
        // device — including while the pointer sat still. Below a third of a
        // pixel nothing is visible, so snap and skip the writes.
        const dDot = Math.abs(mx - cx) + Math.abs(my - cy);
        if (dDot > 0.3) {
          cx += (mx - cx) * 0.4;
          cy += (my - cy) * 0.4;
          dot.style.transform = `translate3d(${cx}px, ${cy}px, 0) translate(-50%, -50%)`;
        } else {
          cx = mx;
          cy = my;
        }
        if (glow) {
          const dGlow = Math.abs(mx - gx) + Math.abs(my - gy);
          if (dGlow > 0.3) {
            gx += (mx - gx) * 0.09;
            gy += (my - gy) * 0.09;
            glow.style.transform = `translate3d(${gx}px, ${gy}px, 0) translate(-50%, -50%)`;
          } else {
            gx = mx;
            gy = my;
          }
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);

      window.addEventListener(
        'mousemove',
        (e) => {
          mx = e.clientX;
          my = e.clientY;
          if (!primed) {
            // Land both on the first real position instead of sliding in from
            // the top-left corner of the viewport.
            cx = gx = mx;
            cy = gy = my;
            primed = true;
          }
          cursorEl.classList.add('is-visible');
          glow?.classList.add('is-visible');
          const overTarget = (e.target as HTMLElement)?.closest?.('a, button, .glass-interactive, .tile');
          cursorEl.classList.toggle('is-active', !!overTarget);
        },
        { passive: true }
      );
      document.documentElement.addEventListener('mouseleave', () => {
        cursorEl.classList.remove('is-visible');
        glow?.classList.remove('is-visible');
      });
    }

    // One listener shape for every surface that lights under the pointer. The
    // experience entries are in the list too — they use the same --mx/--my pair,
    // just at a smaller radius and a lower alpha, because an entry is read, not
    // clicked, and shouldn't advertise itself as hard as a project card.
    if (fineHover && !reduced) {
      document.querySelectorAll<HTMLElement>('.project-card, .exp-item').forEach((card) => {
        let cardRaf: number | null = null;
        let mx = 0, my = 0;
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          mx = e.clientX - rect.left;
          my = e.clientY - rect.top;
          if (cardRaf) return;
          cardRaf = requestAnimationFrame(() => {
            card.style.setProperty('--mx', `${mx}px`);
            card.style.setProperty('--my', `${my}px`);
            cardRaf = null;
          });
        });
      });
    }

    // Copy the address instead of forcing a mail client to open.
    document.querySelectorAll<HTMLButtonElement>('.copy-email').forEach((btn) => {
      // A sibling now, not a child: as the button's own content it was the only
      // source of its accessible name, so the name became "Copied" for 1800ms.
      const label = btn.parentElement?.querySelector('.copy-label') as HTMLElement | null;
      let resetTimer: number | undefined;
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        } catch {
          // Nothing announced and no cyan: the unchanged button is the honest
          // signal that the copy did not happen.
          return;
        }
        btn.classList.add('is-copied');
        if (label) label.textContent = 'Copied';
        window.clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => {
          btn.classList.remove('is-copied');
          // Back to empty, not back to a label — the status node only ever
          // holds a status.
          if (label) label.textContent = '';
        }, 1800);
      });
    });

    // Contact sheet: one dialog, two presentations, chosen the way Apple splits
    // regular from compact width — an anchored pull-down popover on a pointer
    // device, a bottom action sheet on a phone. The trigger stays a mailto
    // anchor in the markup, so this is pure enhancement: no script, no
    // interception, and the button still opens a mail client.
    const sheet = document.getElementById('contactsheet');
    const contactTriggers = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-contact-open]'));
    if (sheet && contactTriggers.length) {
      const panel = sheet.querySelector('.csheet-panel') as HTMLElement;
      const wantsPopover = () =>
        window.matchMedia('(min-width:641px) and (hover:hover) and (pointer:fine)').matches;
      let opener: HTMLElement | null = null;
      let closeTimer: number | undefined;
      let trackRaf = 0;
      let lastAnchor = '';

      // Recomputed per use: which controls exist depends on the presentation —
      // Cancel is display:none in the popover, the close X is display:none in
      // the sheet, and offsetParent is null for both when they are.
      const focusables = () =>
        Array.from(panel.querySelectorAll<HTMLElement>('a[href], button')).filter(
          (el) => el.offsetParent !== null,
        );

      const close = () => {
        // Guarded on is-open, not on hidden: hidden only becomes true 300ms
        // later in finish(), and place() calls close() from inside the rAF
        // tracker when the anchor scrolls away. Without this the tracker
        // re-entered close() every frame of that 300ms and queued a finish()
        // per frame — each one able to fire later and unlock body scroll behind
        // whatever had been opened since.
        if (sheet.hidden || !sheet.classList.contains('is-open')) return;
        sheet.classList.remove('is-open');
        if (trackRaf) { cancelAnimationFrame(trackRaf); trackRaf = 0; }
        opener?.setAttribute('aria-expanded', 'false');
        window.clearTimeout(closeTimer);
        const finish = () => {
          sheet.hidden = true;
          document.body.style.overflow = '';
          lenis?.start();
          opener?.focus({ preventScroll: true });
          opener = null;
        };
        if (reduced) finish();
        else closeTimer = window.setTimeout(finish, 300);
      };

      const place = () => {
        if (!opener || !sheet.classList.contains('is-popover')) return;
        const r = opener.getBoundingClientRect();
        // An anchored popover with its anchor scrolled off screen is just a
        // panel floating in the corner. Dismiss rather than drift.
        if (r.bottom < 0 || r.top > window.innerHeight) { close(); return; }
        // Nothing moved — skip the writes rather than dirty layout every frame.
        const anchor = `${r.top}|${r.left}|${r.width}|${window.innerHeight}`;
        if (anchor === lastAnchor) return;
        lastAnchor = anchor;
        const margin = 12;
        const pw = panel.offsetWidth;
        const ph = panel.offsetHeight;
        const left = Math.min(
          Math.max(r.left + r.width / 2 - pw / 2, margin),
          window.innerWidth - pw - margin,
        );
        // Flip above the button when there isn't room below, and move the
        // growth origin to the edge nearest the button so the animation still
        // reads as coming out of it.
        const below = r.bottom + 10;
        const flip = below + ph > window.innerHeight - margin && r.top - ph - 10 > margin;
        panel.style.left = `${left}px`;
        panel.style.top = `${flip ? r.top - ph - 10 : below}px`;
        panel.style.setProperty('--pop-ox', `${r.left + r.width / 2 - left}px`);
        panel.style.setProperty('--pop-oy', flip ? '100%' : '0');
      };

      // A scroll listener is not enough to keep a popover on its anchor. The
      // sticky nav is in flow, so it compacts 56px -> 46px and shifts the hero
      // button 10px without any scroll event at all — and it expands again just
      // from the pointer passing over it. Watching the trigger's own rect each
      // frame catches every cause; place() no-ops unless something moved, and
      // the loop only runs while the popover is open.
      const track = () => {
        if (sheet.hidden || !sheet.classList.contains('is-open') || !sheet.classList.contains('is-popover')) {
          trackRaf = 0;
          return;
        }
        place();
        trackRaf = requestAnimationFrame(track);
      };

      const open = (trigger: HTMLElement) => {
        window.clearTimeout(closeTimer);
        opener = trigger;
        const pop = wantsPopover();
        sheet.classList.toggle('is-popover', pop);
        // Only the compact presentation is actually modal: the sheet path below
        // stops Lenis and locks body scroll, the popover path deliberately does
        // neither. Hardcoding aria-modal="true" told assistive tech the rest of
        // the page was inert while it was still scrolling. (The Tab trap and the
        // light-dismiss scrim work in both, so this is a state mismatch rather
        // than an exposure hole — but it is the kind AT acts on.)
        sheet.setAttribute('aria-modal', pop ? 'false' : 'true');
        sheet.hidden = false;
        if (pop) {
          // Measured after unhiding — offsetWidth needs the panel laid out.
          // Synchronous, so the panel is never painted at a stale position.
          lastAnchor = '';
          place();
        } else {
          // Modal at compact width, so the page can't scroll behind the scrim.
          lenis?.stop();
          document.body.style.overflow = 'hidden';
        }
        trigger.setAttribute('aria-expanded', 'true');
        // The tracker starts inside this frame, not before it: it bails unless
        // is-open is already set, and two rAFs queued in the same tick run in
        // the order queued.
        requestAnimationFrame(() => {
          sheet.classList.add('is-open');
          if (pop && !trackRaf) trackRaf = requestAnimationFrame(track);
        });
        focusables()[0]?.focus({ preventScroll: true });
      };

      contactTriggers.forEach((t) => {
        // Added here, not in the markup: until this line runs the anchor really
        // is just a mailto, and claiming a dialog it can't open would be a lie.
        t.setAttribute('aria-haspopup', 'dialog');
        t.setAttribute('aria-expanded', 'false');
        t.setAttribute('aria-controls', 'contactsheet');
        t.addEventListener('click', (e) => { e.preventDefault(); open(t); });
      });

      sheet.querySelectorAll('[data-csheet-dismiss]').forEach((el) => el.addEventListener('click', close));
      // Following a link is a dismissal. Without this a mailto or a new tab
      // leaves the panel sitting open behind whatever just happened.
      panel.querySelectorAll('a[href]').forEach((a) => a.addEventListener('click', () => close()));

      document.addEventListener('keydown', (e) => {
        if (sheet.hidden) return;
        if (e.key === 'Escape') { e.preventDefault(); close(); }
        else if (e.key === 'Tab') {
          const f = focusables();
          if (!f.length) return;
          const at = f.indexOf(document.activeElement as HTMLElement);
          e.preventDefault();
          f[(at + (e.shiftKey ? -1 : 1) + f.length) % f.length].focus();
        }
      });

      window.addEventListener('resize', () => {
        if (sheet.hidden) return;
        // A phone firing resize for the URL bar shouldn't dismiss anything —
        // only a genuine change of presentation is worth closing for.
        if (wantsPopover() !== sheet.classList.contains('is-popover')) close();
        else place();
      });
    }

    // Travelling marker on the experience rail: the dot tracks whichever card the
    // reader is level with, and the rail fills in behind it. Purely additive —
    // with no JS the rail is still drawn and every card still reads.
    const expList = document.querySelector<HTMLElement>('.exp');
    const expItems = Array.from(document.querySelectorAll<HTMLElement>('.exp-item'));
    if (expList && expItems.length) {
      let expRaf: number | null = null;
      const updateExpProgress = () => {
        const listRect = expList.getBoundingClientRect();
        // Ignore the section entirely while it is off-screen.
        if (listRect.bottom < 0 || listRect.top > window.innerHeight) return;
        // Reference line sits high — roughly a card's height below the nav — so
        // the first card is current on arrival and each one then holds the state
        // for about its own height of scrolling. At mid-viewport two cards are
        // always past the line at once and the first could never win.
        const scanY = Math.max(140, window.innerHeight * 0.28);
        let current = 0;
        expItems.forEach((li, i) => {
          if (li.getBoundingClientRect().top <= scanY) current = i;
        });
        expItems.forEach((li, i) => li.classList.toggle('is-current', i === current));

        const marker = expItems[current].querySelector('.exp-marker') as HTMLElement;
        const mRect = marker.getBoundingClientRect();
        // Rail starts .62rem below the list top; fill to the active dot's centre.
        const railTop = listRect.top + 0.62 * 16;
        expList.style.setProperty('--exp-progress', `${Math.max(0, mRect.top + mRect.height / 2 - railTop)}px`);
      };
      const onExpScroll = () => {
        if (expRaf) return;
        expRaf = requestAnimationFrame(() => {
          updateExpProgress();
          expRaf = null;
        });
      };
      window.addEventListener('scroll', onExpScroll, { passive: true });
      window.addEventListener('resize', onExpScroll);
      updateExpProgress();
    }

    // Certificate hover preview. The scan lifts out of its own tile at roughly
    // twice grid size while the pointer rests on it. Pointer-only by design: the
    // click viewer below is the path that works on touch, and it is still the
    // only place the scan reaches its native 800px.
    // All six scans are one template — same header, same name, same layout, one
    // course line different — so replacing the src in place changes almost no
    // pixels and the eye reads it as the same certificate. Every surface that
    // can change which scan it holds therefore also changes an accent hue, and
    // stages the change as a beat rather than a substitution. Kept inside the
    // blue-to-violet range the ambient blobs already work in.
    const CERT_HUES = [190, 205, 219, 234, 249, 264];
    const wait = (ms: number) => new Promise((r) => window.setTimeout(r, ms));

    const certPop = document.getElementById('certpop');
    const certGrid = document.querySelector<HTMLElement>('.cert-grid');
    const certTiles = Array.from(document.querySelectorAll<HTMLButtonElement>('.cert'));
    if (certPop && certGrid && certTiles.length && fineHover) {
      const popImg = document.getElementById('certpop-img') as HTMLImageElement;
      const popN = document.getElementById('certpop-n') as HTMLElement;
      const popTitle = document.getElementById('certpop-title') as HTMLElement;
      const popDate = document.getElementById('certpop-date') as HTMLElement;
      const popBadge = document.getElementById('certpop-badge') as HTMLElement;
      let swapGen = 0;
      let shown: HTMLButtonElement | null = null;
      let target: HTMLButtonElement | null = null;
      let enterTimer: number | undefined;
      let hideTimer: number | undefined;

      // Above the tile by preference, below when there isn't room, pinned into
      // the viewport when neither side has any. The growth origin follows the
      // choice, so the scan always appears to come out of its own thumbnail.
      const place = (tile: HTMLElement) => {
        const r = tile.getBoundingClientRect();
        const w = certPop.offsetWidth;
        const h = certPop.offsetHeight;
        const M = 14;
        const left = Math.max(M, Math.min(r.left + r.width / 2 - w / 2, window.innerWidth - w - M));
        let top = r.top - h - 12;
        let originY = 'bottom';
        if (top < M) {
          top = r.bottom + 12;
          originY = 'top';
          if (top + h > window.innerHeight - M) {
            top = Math.max(M, (window.innerHeight - h) / 2);
            originY = 'center';
          }
        }
        // `translate`, not left/top — it is the one the .is-open rule can glide.
        certPop.style.translate = `${left}px ${top}px`;
        // Origin points back at the tile in all three cases, so the scan always
        // reads as growing out of its own thumbnail even when it lands centred.
        certPop.style.transformOrigin = `${r.left + r.width / 2 - left}px ${originY}`;
        tile.classList.toggle('is-covered', top < r.bottom && top + h > r.top);
      };

      // Everything that identifies which certificate the panel is holding, moved
      // in one go so the hue, the badge and the caption never disagree.
      const dress = (tile: HTMLButtonElement) => {
        const hue = CERT_HUES[Number(tile.dataset.cert) % CERT_HUES.length];
        certPop.style.setProperty('--cert-hue', String(hue));
        tile.style.setProperty('--cert-hue', String(hue));
        popImg.src = tile.dataset.src ?? '';
        popBadge.textContent = tile.dataset.n ?? '';
        popN.textContent = tile.dataset.n ?? '';
        popTitle.textContent = tile.dataset.title ?? '';
        popDate.textContent = tile.dataset.date ?? '';
      };

      const show = (tile: HTMLButtonElement) => {
        window.clearTimeout(hideTimer);
        // A swap is the pointer moving between tiles while the panel is already
        // up — the case the open animation can't cover, because .is-open never
        // leaves. A first open still runs the original grow-out-of-the-tile.
        const swapping = shown !== null && shown !== tile && !reduced;
        shown?.classList.remove('is-peeked', 'is-covered');
        shown = tile;
        tile.classList.add('is-peeked');
        certGrid.classList.add('is-peeking');
        certPop.hidden = false;

        if (!swapping) {
          swapGen++;
          certPop.classList.remove('is-swapping');
          dress(tile);
          // aspect-ratio gives the frame its height before the scan decodes, so
          // this measures right even on the very first hover.
          place(tile);
          requestAnimationFrame(() => certPop.classList.add('is-open'));
          return;
        }

        // Staged: clear the frame, change the scan while nothing is showing,
        // then let it settle back in. The glide to the new tile runs underneath.
        const mine = ++swapGen;
        certPop.classList.add('is-swapping');
        place(tile);
        void (async () => {
          await wait(130);
          if (mine !== swapGen) return;
          dress(tile);
          // Cached from the grid, but decoding still isn't synchronous, and the
          // frame's white backing would flash before a slow one landed. A sweep
          // across the row fires this per tile, so a decode that resolves after
          // the pointer has moved on must not paint its stale scan.
          try { await popImg.decode(); } catch { /* replaced or aborted */ }
          if (mine !== swapGen) return;
          certPop.classList.remove('is-swapping');
        })();
      };

      const hide = () => {
        window.clearTimeout(enterTimer);
        target = null;
        if (!shown) return;
        shown.classList.remove('is-peeked', 'is-covered');
        shown = null;
        certGrid.classList.remove('is-peeking');
        // Orphan any swap still mid-beat, or its decode lands after this and
        // leaves the panel emptied out for the next hover to open into.
        swapGen++;
        certPop.classList.remove('is-open', 'is-swapping');
        // Let it fade before it leaves the layout; re-showing cancels this.
        window.clearTimeout(hideTimer);
        hideTimer = window.setTimeout(() => {
          if (!shown) certPop.hidden = true;
        }, 260);
      };

      // Read off the live event target with .closest() — the tile wraps nested
      // spans and an image, which desync per-element enter/leave listeners.
      document.addEventListener(
        'mousemove',
        (e) => {
          const tile = ((e.target as HTMLElement)?.closest?.('.cert') ?? null) as HTMLButtonElement | null;
          if (tile === target) return;
          target = tile;
          window.clearTimeout(enterTimer);
          if (!tile) hide();
          // Sweeping across the row shouldn't fire six previews; but once one is
          // already up, moving to its neighbour swaps straight away.
          else if (shown) show(tile);
          else enterTimer = window.setTimeout(() => show(tile), 120);
        },
        { passive: true }
      );

      // Deliberately NOT opened on focus. Measured at 1280x720, the panel covered
      // 100% of the focused tile for certificates 18 and 19 and 55% for 23 and 25
      // — a WCAG 2.2 SC 2.4.11 failure — and `.is-covered` then dropped that tile
      // to opacity .42 and hid its caption, erasing the last evidence of where
      // focus was. It also flickered: tabbing a tile into view fires the scroll
      // listener below, which hides the panel again.
      //
      // No replacement is needed. The preview is pointer-only by design (see the
      // comment above), and Enter on the tile already opens the full viewer at
      // native 800px — the better path anyway, since that is where the printed
      // course line is legible. Keeping this pointer-only also means .is-covered
      // can only ever fire under a pointer, which is the one place dimming the
      // source tile is the right behaviour.

      // Dismissible by Escape, and gone before the viewer's scrim lands on top
      // of it or the page moves out from under it.
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') hide(); });
      document.addEventListener('click', hide);
      window.addEventListener('scroll', hide, { passive: true });
      window.addEventListener('resize', hide);
    }

    // Certificate viewer. At grid size the printed course line — the evidence the
    // caption claims — is unreadable, so each tile opens the full scan and the
    // whole set is reachable by arrow key without going back to the grid.
    const certView = document.getElementById('certview');
    const certTriggers = Array.from(document.querySelectorAll<HTMLButtonElement>('.cert'));
    if (certView && certTriggers.length) {
      const viewImg = document.getElementById('certview-img') as HTMLImageElement;
      const viewN = document.getElementById('certview-n') as HTMLElement;
      const viewTitle = document.getElementById('certview-title') as HTMLElement;
      const viewDate = document.getElementById('certview-date') as HTMLElement;
      const viewPos = document.getElementById('certview-pos') as HTMLElement;
      const prevBtn = certView.querySelector('.certview-prev') as HTMLButtonElement;
      const nextBtn = certView.querySelector('.certview-next') as HTMLButtonElement;
      const closeBtn = certView.querySelector('.certview-close') as HTMLButtonElement;
      let index = 0;
      let lastFocused: HTMLElement | null = null;
      let viewGen = 0;

      const dress = (t: HTMLButtonElement) => {
        certView.style.setProperty('--cert-hue', String(CERT_HUES[Number(t.dataset.cert) % CERT_HUES.length]));
        viewImg.src = t.dataset.src ?? '';
        viewImg.alt = `ProgrammingAdvices certificate, course ${t.dataset.n}: ${t.dataset.title}`;
        viewN.textContent = t.dataset.n ?? '';
        viewTitle.textContent = t.dataset.title ?? '';
        viewDate.textContent = t.dataset.date ?? '';
        viewPos.textContent = String(index + 1);
      };

      // `dir` is 0 when opening and ±1 when stepping. Stepping gets the same
      // staged beat the hover panel does, for the same reason: the scans are
      // indistinguishable at a glance, so a bare src swap left the arrow keys
      // looking broken.
      const show = (i: number, dir = 0) => {
        index = (i + certTriggers.length) % certTriggers.length;
        const t = certTriggers[index];
        if (!dir || reduced) {
          viewGen++;
          certView.classList.remove('is-swapping');
          dress(t);
          return;
        }
        const mine = ++viewGen;
        certView.style.setProperty('--swap-dir', String(dir));
        certView.classList.add('is-swapping');
        void (async () => {
          await wait(130);
          if (mine !== viewGen) return;
          dress(t);
          try { await viewImg.decode(); } catch { /* replaced or aborted */ }
          if (mine !== viewGen) return;
          certView.classList.remove('is-swapping');
        })();
      };

      const open = (i: number) => {
        lastFocused = document.activeElement as HTMLElement;
        show(i);
        certView.hidden = false;
        // Stop Lenis, or the page keeps scrolling behind the scrim.
        lenis?.stop();
        document.body.style.overflow = 'hidden';
        requestAnimationFrame(() => certView.classList.add('is-open'));
        closeBtn.focus();
      };

      const close = () => {
        certView.classList.remove('is-open');
        // Orphan a step still mid-beat, so the next open doesn't start blank.
        viewGen++;
        certView.classList.remove('is-swapping');
        const finish = () => {
          certView.hidden = true;
          document.body.style.overflow = '';
          lenis?.start();
          lastFocused?.focus();
        };
        if (reduced) finish();
        else window.setTimeout(finish, 260);
      };

      certTriggers.forEach((t, i) => t.addEventListener('click', () => open(i)));
      prevBtn.addEventListener('click', () => show(index - 1, -1));
      nextBtn.addEventListener('click', () => show(index + 1, 1));
      certView.querySelectorAll('[data-certview-dismiss]').forEach((el) => el.addEventListener('click', close));

      document.addEventListener('keydown', (e) => {
        if (certView.hidden) return;
        if (e.key === 'Escape') { e.preventDefault(); close(); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); show(index - 1, -1); }
        else if (e.key === 'ArrowRight') { e.preventDefault(); show(index + 1, 1); }
        else if (e.key === 'Tab') {
          // Keep focus inside the dialog while it's open.
          const f = [closeBtn, prevBtn, nextBtn];
          const at = f.indexOf(document.activeElement as HTMLButtonElement);
          e.preventDefault();
          f[(at + (e.shiftKey ? -1 : 1) + f.length) % f.length].focus();
        }
      });
    }

    // A section goes active once its top passes a scan line set from the viewport
    // height. Deterministic regardless of section height, unlike an intersection ratio.
    const navLinkEls = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-link'));
    const navIndicator = document.querySelector('.nav-indicator') as HTMLElement | null;

    // The dot hops to its new position, driven per frame rather than by a CSS
    // transition so an interrupted hop resumes from where the dot actually is.
    let dotRaf: number | null = null;
    let liveX: number | null = null;
    let liveY = 0;
    function animateIndicatorTo(targetX: number) {
      if (!navIndicator) return;
      if (liveX === null || reduced) {
        navIndicator.style.transform = `translate(${targetX}px, 0px)`;
        liveX = targetX;
        liveY = 0;
        return;
      }
      const fromX = liveX;
      const fromY = liveY;
      const dx = targetX - fromX;
      if (Math.abs(dx) < 0.5 && Math.abs(fromY) < 0.1) return;
      if (dotRaf) cancelAnimationFrame(dotRaf);
      const duration = 420;
      const peak = Math.min(5, 2 + Math.abs(dx) * 0.015);
      const start = performance.now();
      const easeX = (t: number) => 1 - Math.pow(1 - t, 3);
      const step = (now: number) => {
        const p = Math.min(1, (now - start) / duration);
        const settle = 1 - easeX(p);
        const x = fromX + dx * easeX(p);
        const y = fromY * settle - peak * Math.sin(p * Math.PI);
        navIndicator.style.transform = `translate(${x}px, ${y}px)`;
        liveX = x;
        liveY = y;
        if (p < 1) {
          dotRaf = requestAnimationFrame(step);
        } else {
          dotRaf = null;
        }
      };
      dotRaf = requestAnimationFrame(step);
    }

    function setActiveNavLink(link: HTMLAnchorElement) {
      navLinkEls.forEach((a) => {
        const active = a === link;
        a.classList.toggle('is-active', active);
        if (active) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
      if (navIndicator) {
        const x = link.offsetLeft + link.offsetWidth / 2 - navIndicator.offsetWidth / 2;
        animateIndicatorTo(x);
        navIndicator.classList.add('is-visible');
      }
    }

    const spyEntries = navLinkEls
      .map((a) => {
        const sel = a.dataset.spy || a.getAttribute('href');
        const el = sel ? document.querySelector(sel) : null;
        return el ? { link: a, el } : null;
      })
      .filter((s): s is { link: HTMLAnchorElement; el: Element } => s !== null)
      // The scan below is last-match-wins, which only means anything in document
      // order — so sort, never trust the nav array. Authored order used to run
      // Work before Stack before Experience while the page runs the other way,
      // and #experience being last of the three meant it won every frame from its
      // own top to the bottom of the page: Stack and Work could never light up.
      .sort((a, b) =>
        a.el.compareDocumentPosition(b.el) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1,
      );

    if (spyEntries.length) {
      // Sections are contiguous, so the handoff happens the moment the incoming
      // section's top crosses this line. At the old fixed 110 the outgoing
      // section had to be all but gone before the nav admitted it: you could be
      // looking at a heading filling seven eighths of the screen and still be
      // told you were in the section above. Half the viewport puts the handoff
      // within ~40px of the point where the incoming section actually takes over
      // the larger share of the screen, which is what the reader is judging by.
      // The 520 ceiling is load-bearing, not taste: a clicked section lands at
      // scroll-margin-top (84px), so the line has to stay well above 84 + the
      // shortest section's height (Stack, 648) or the section *after* the one
      // just clicked would win the scan and light the wrong link.
      const scanLine = () => Math.min(Math.max(window.innerHeight * 0.5, 160), 520);
      let spyRaf: number | null = null;
      const updateActiveLink = () => {
        const SCAN_Y = scanLine();
        let current = spyEntries[0];
        for (const entry of spyEntries) {
          if (entry.el.getBoundingClientRect().top <= SCAN_Y) current = entry;
        }
        // The last section is too short to ever reach the scan line, so at the
        // bottom of the page claim it explicitly.
        const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
        if (atBottom) current = spyEntries[spyEntries.length - 1];
        setActiveNavLink(current.link);
      };
      const onScroll = () => {
        if (spyRaf) return;
        spyRaf = requestAnimationFrame(() => {
          updateActiveLink();
          spyRaf = null;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      updateActiveLink();
    }

    // Hysteresis (48px in, 24px out) because Lenis overshoots slightly on settle.
    const navEl = document.querySelector('header.nav');
    if (navEl) {
      let navRaf: number | null = null;
      let isCompact = false;
      const updateNavCompact = () => {
        const y = window.scrollY;
        if (!isCompact && y > 48) {
          isCompact = true;
          navEl.classList.add('is-compact');
        } else if (isCompact && y < 24) {
          isCompact = false;
          navEl.classList.remove('is-compact');
        }
      };
      const onNavScroll = () => {
        if (navRaf) return;
        navRaf = requestAnimationFrame(() => {
          updateNavCompact();
          navRaf = null;
        });
      };
      window.addEventListener('scroll', onNavScroll, { passive: true });
      updateNavCompact();
    }

    // Reveals are visible in CSS by default; JS only opts them into the fade-up.
    if (!reduced && 'IntersectionObserver' in window) {
      const reveals = Array.from(document.querySelectorAll('[data-reveal]'));
      reveals.forEach((el) => el.classList.add('io-pending'));
      const revealObserver = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.remove('io-pending');
              obs.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
      );
      reveals.forEach((el) => revealObserver.observe(el));

      const bars = document.querySelectorAll('.bar-fill');
      bars.forEach((el) => el.classList.add('bar-pending'));
      const barObserver = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.remove('bar-pending');
              obs.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.3 }
      );
      bars.forEach((el) => barObserver.observe(el));
    }
  </script>
</Layout>
