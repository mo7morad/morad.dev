---
import Layout from '../layouts/Layout.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
---

<Layout
  title="Mohamed Morad"
  description="Backend engineer, Apple Developer Academy Bali. Trippé — a travel app whose backend refuses to state a price it cannot trace to a quoted source."
>
  <header class="nav">
    <div class="wrap nav-inner">
      <a href="#top" class="brand" data-scroll-to>MORAD<span>.</span></a>
      <nav class="nav-links">
        <a href="#about" class="textlink hide-mobile" data-scroll-to>About</a>
        <a href="#work" class="textlink hide-mobile" data-scroll-to>Work</a>
        <a href="mailto:momurad.business@gmail.com" class="btn btn-ghost">Email</a>
      </nav>
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <div class="wrap">
        <div class="hero-grid">
          <div>
            <p class="eyebrow">Backend Engineer &middot; Apple Developer Academy, Bali</p>
            <h1 class="thesis" id="hero-h1" aria-label="The engineer who won't state what he can't prove.">
              <span class="word" aria-hidden="true">The</span> <span class="word" aria-hidden="true">engineer</span> <span class="word" aria-hidden="true">who</span> <span class="word" aria-hidden="true">won&rsquo;t</span> <span class="word" aria-hidden="true">state</span> <span class="word" aria-hidden="true">what</span> <span class="word" aria-hidden="true">he</span> <span class="word" aria-hidden="true">can&rsquo;t</span> <span class="word" aria-hidden="true">prove.</span>
            </h1>
            <p class="lede" data-reveal>I spent twenty-one months on fundamentals before I shipped anything. Then I built Trippé &mdash; a travel app whose backend refuses to state a price it cannot trace to a quoted source. Backend, iOS client, cost engine: I wrote all three.</p>
            <div class="hero-cta" data-reveal>
              <a href="#work" class="btn btn-cream" data-scroll-to>View the work &darr;</a>
              <a href="https://apps.apple.com/app/id6766072256" class="textlink" target="_blank" rel="noopener">Live on the App Store &nearr;</a>
              <a href="mailto:momurad.business@gmail.com" class="textlink">momurad.business@gmail.com</a>
            </div>
            <div class="record-row" id="record" data-reveal>
              <div class="record-item"><div class="v mono num">669+599</div><div class="l">Commits, roadmap + Trippé backend</div></div>
              <div class="record-item"><div class="v mono num">21 months</div><div class="l">Fundamentals before first ship</div></div>
              <div class="record-item"><div class="v mono num">0.9&thinsp;:&thinsp;1</div><div class="l">Test files to source files</div></div>
              <div class="record-item"><div class="v mono">Open</div><div class="l">Remote or relocation</div></div>
            </div>
          </div>
          <div class="phone-wrap" data-reveal>
            <PhoneMockup
              src="/images/trippe/destination-sao-miguel.jpg"
              alt="Trippé app screen showing a São Miguel, Azores trip recommendation with who/length/when/budget details."
            />
          </div>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section id="about">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <p class="section-eyebrow">About</p>
          <h2 class="section-title">Bali, by way of Cairo.</h2>
        </div>
        <div class="about-grid">
          <div data-reveal>
            <p class="p-lede">Egyptian, in Bali since 2023 on an Informatics scholarship. Backend-first: on Tripp&eacute; I wrote the Cloudflare Worker backend, the SwiftUI client, and the cost engine myself, because the alternative was hiring someone I couldn&rsquo;t afford or shipping half a product. I don&rsquo;t trust a number until I can see where it came from &mdash; including the ones my own code produces.</p>
            <div class="arc-list">
              <div class="a"><b>2023</b><span>CS50 in Cairo explains what a computer actually does. First build &mdash; a Python/tkinter download manager &mdash; loses its source: no git, no backup. <code class="mono">git init</code> has been the first thing I type ever since.</span></div>
              <div class="a"><b>AUG 2023</b><span>Leave Egypt on a scholarship &mdash; Informatics at UII, Indonesia.</span></div>
              <div class="a"><b>MAY 2024&ndash;FEB 2026</b><span>Twenty-one months of self-curated backend fundamentals: 25 courses, 1,329 problems, 669 commits, ending in DVLD.</span></div>
              <div class="a"><b>MAR 2026</b><span>Apple Developer Academy, Bali &mdash; first Egyptian in the cohort, ~220 places from 5,000+ applicants.</span></div>
              <div class="a"><b>SEP 2026</b><span>Tripp&eacute; goes live on the App Store &mdash; backend, iOS app, and cost engine, alone.</span></div>
              <div class="a"><b>DEC 2026 &rarr; AUG 2027</b><span>Academy ends, then the degree lands. Open to remote work or relocation now.</span></div>
            </div>
          </div>
          <div data-reveal>
            <div class="stack-groups">
              <div class="grp">
                <p class="lbl">Backend</p>
                <div class="chips"><span class="chip">TypeScript</span><span class="chip">Cloudflare Workers</span><span class="chip">Node.js</span><span class="chip">Postgres / Supabase</span><span class="chip">C#</span><span class="chip">ADO.NET</span><span class="chip">SQL Server</span></div>
              </div>
              <div class="grp">
                <p class="lbl">iOS</p>
                <div class="chips"><span class="chip">Swift</span><span class="chip">SwiftUI</span><span class="chip">SwiftData</span><span class="chip">Core ML</span><span class="chip">App Intents</span></div>
              </div>
              <div class="grp">
                <p class="lbl">Systems</p>
                <div class="chips"><span class="chip">Debian</span><span class="chip">Nginx</span><span class="chip">SSH</span><span class="chip">Git</span></div>
              </div>
            </div>
            <p class="foot" style="margin-top:1.1rem;">Every item here is proven on a project on this page, not a wishlist.</p>
          </div>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section id="work">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <p class="section-eyebrow">Selected Work</p>
          <h2 class="section-title">Five projects, one instinct: don&rsquo;t claim it, show the receipt.</h2>
        </div>
      </div>

      <div class="wrap work-item" id="trippe" style="padding-top:1.4rem; padding-bottom:3rem;">
        <div class="grid">
          <div data-reveal>
            <div class="shots">
              <div>
                <PhoneMockup
                  size="sm"
                  src="/images/trippe/destination-sao-miguel.jpg"
                  alt="Trippé destination screen for São Miguel, Azores."
                />
                <p class="cap">Destination reveal &mdash; App Store screenshot</p>
              </div>
              <div>
                <PhoneMockup
                  size="sm"
                  src="/images/trippe/estimated-spending.jpg"
                  alt="Trippé estimated cost breakdown screen, showing flights, stays, food, and activities."
                />
                <p class="cap">Cost breakdown &mdash; every line item priced separately</p>
              </div>
            </div>
          </div>
          <div data-reveal>
            <p class="section-eyebrow">01 &middot; Trippé</p>
            <h2 class="section-title" style="margin-bottom:.9rem;">A price that has to cite itself.</h2>
            <p class="p-lede">Trippé recommends a trip, then prices it against real harvested data before you see it. The backend&rsquo;s pricing table has a hard constraint: <b>a price row without a quoted source is discarded, not stored</b>. I designed and built the Cloudflare Worker backend, the SwiftUI client, and the cost engine between them, alone.</p>
            <div class="kv-list">
              <div class="row"><span class="k">Backend</span><span class="v mono">599 commits &middot; TypeScript &middot; one runtime dep (<code style="color:var(--teal)">jose</code>)</span></div>
              <div class="row"><span class="k">Test coverage</span><span class="v mono">123 test files / 144 source files</span></div>
              <div class="row"><span class="k">iOS client</span><span class="v mono">250 commits &middot; 47,075 lines, SwiftUI</span></div>
              <div class="row"><span class="k">On-device AI</span><span class="v mono">Apple Foundation Models, with a kill-switch fallback</span></div>
            </div>
            <div class="quote-block">
              <code>price_observation.source_quote text not null</code><br />
              An extraction that can&rsquo;t quote its source is discarded &mdash; not stored. &mdash; migration 0006
            </div>
            <a href="https://apps.apple.com/app/id6766072256" class="btn btn-ghost" target="_blank" rel="noopener">View on the App Store &nearr;</a>
          </div>
        </div>
      </div>

      <hr class="divider" />

      <div class="wrap" id="roadmap" style="padding-top:3rem; padding-bottom:3rem;">
        <div class="section-head" data-reveal>
          <p class="section-eyebrow">02 &middot; Backend Fundamentals Roadmap</p>
          <h2 class="section-title">Twenty-one months before I shipped anything, on purpose.</h2>
        </div>
        <p class="p-lede" data-reveal style="max-width:60ch;">A self-curated backend curriculum: C++, algorithms across six levels, OOP, data structures, C# WinForms, SQL, T-SQL, REST APIs, SOLID, testing &mdash; twenty-five courses, 1,329 solved problems, ending in a capstone.</p>

        <div class="timeline" data-reveal aria-hidden="true">
          <div class="track"></div>
          <div class="pt" style="left:30%;"><span class="lbl">75</span><span class="dot"></span><span class="sub">DEC &lsquo;24</span></div>
          <div class="pt" style="left:55%;"><span class="lbl">79</span><span class="dot"></span><span class="sub">FEB &lsquo;25</span></div>
          <div class="pt" style="left:84%;"><span class="lbl">174</span><span class="dot"></span><span class="sub">DEC &lsquo;25</span></div>
        </div>
        <div class="timeline-range" aria-hidden="true"><span>MAY 2024</span><span>FEB 2026</span></div>
        <p class="sr-only">Verified commit counts at three points in the roadmap: 75 commits in December 2024, 79 in February 2025, and 174 in December 2025, across a total span from May 2024 to February 2026.</p>
        <p class="foot" style="font-size:.76rem;color:var(--text-faint);margin:0 0 1.8rem;" data-reveal>Commits per month at three measured points along 669 total &mdash; the only months verified so far, not a full monthly count.</p>

        <div class="rewrite-list" data-reveal>
          <div class="r"><b>V1</b> Procedural C++, flat-file persistence, single-admin CRUD.</div>
          <div class="r"><b>V3</b> Adds role-based auth, multi-user CRUD.</div>
          <div class="r"><b>V4</b> Full OOP rewrite &mdash; <code class="mono" style="color:var(--teal);font-size:.78rem;">clsBankClient</code>, multi-currency exchange, ~6,000 lines.</div>
        </div>
        <div class="quote-block" data-reveal>
          The capstone, <code>DVLD</code>: a driving-license system, C# WinForms + SQL Server, strict 3-tier architecture. 134 files, 28,541 lines. Data access is raw, parameterized ADO.NET &mdash; no stored procedures, by choice.
        </div>
        <figure class="diagram-frame" data-reveal>
          <img
            src="/images/dvld/db-diagram.png"
            alt="DVLD database schema diagram: thirteen tables including Licenses, Drivers, Applications, Tests, TestAppointments, People, and Users, with foreign-key relationships drawn between them."
            loading="lazy"
          />
        </figure>
        <p class="diagram-cap" data-reveal>The actual schema &mdash; thirteen tables, drawn straight from <code class="mono">DVLD-DB Diagram.png</code> in the repo.</p>
      </div>

      <hr class="divider" />

      <div class="wrap work-item" id="eco" style="padding-top:3rem; padding-bottom:3rem;">
        <div class="grid">
          <div data-reveal>
            <p class="section-eyebrow">03 &middot; ECOdyssey / Sortla</p>
            <h2 class="section-title" style="margin-bottom:.9rem;">Measuring a team&rsquo;s own work honestly enough to stop trusting it.</h2>
            <p class="p-lede">My role on a five-person team building a waste-sorting kiosk (on-device YOLOv8, Core ML). I wrote the belief-fusion engine, the Private-Cloud-Compute second-opinion arbiter, and the test harness that graded both approaches against each other.</p>
            <p class="p-lede">The harness replayed 7 fixed scenarios through the old confidence-vote logic and my belief engine. The old logic was wrong three times. Mine was wrong once. <b>The measurement found a real bug &mdash; it wasn&rsquo;t a demo of a passing test.</b></p>
          </div>
          <div data-reveal>
            <div class="compare">
              <div class="bar-row"><span class="bar-label">Legacy confidence-vote</span><div class="bar-track"><div class="bar-fill legacy" style="--target-width:43%"></div></div><span class="bar-val">3/7</span></div>
              <div class="bar-row"><span class="bar-label">Belief engine (mine)</span><div class="bar-track"><div class="bar-fill belief" style="--target-width:14%"></div></div><span class="bar-val">1/7</span></div>
              <p class="foot">Confidently-wrong verdicts out of 7 fixed fixture scenarios &mdash; BinDecisionBakeOffTests.swift</p>
            </div>
          </div>
        </div>
      </div>

      <hr class="divider" />

      <div class="wrap work-item" id="stickies" style="padding-top:3rem; padding-bottom:3rem;">
        <div class="grid">
          <div data-reveal>
            <div class="shots">
              <div>
                <PhoneMockup
                  size="sm"
                  src="/images/stickies/gate.png"
                  alt="Academy Stickies sign-in gate, a live production screenshot from academy-stickies.pages.dev."
                />
                <p class="cap">Sign-in gate &mdash; live screenshot, academy-stickies.pages.dev</p>
              </div>
            </div>
          </div>
          <div data-reveal>
            <p class="section-eyebrow">04 &middot; ADA-Stickies</p>
            <h2 class="section-title" style="margin-bottom:.9rem;">Shipped for people who&rsquo;d notice if it broke.</h2>
            <p class="p-lede">A private wall of notes for my actual Academy cohort &mdash; magic-link email auth, so nobody needs a password I&rsquo;d have to reset. Live since July 2026, still running.</p>
            <div class="kv-list">
              <div class="row"><span class="k">Stack</span><span class="v mono">Cloudflare Pages &middot; Hono &middot; D1 &middot; R2</span></div>
              <div class="row"><span class="k">Migrations</span><span class="v mono">9 &middot; tested with vitest</span></div>
              <div class="row"><span class="k">Commits</span><span class="v mono">39 (33 mine) &middot; Jul&ndash;Aug 2026</span></div>
              <div class="row"><span class="k">Status</span><span class="v mono">Live &middot; invite-only, real cohort</span></div>
            </div>
            <div style="display:flex; gap:.9rem; flex-wrap:wrap;">
              <a href="https://academy-stickies.pages.dev" class="btn btn-ghost" target="_blank" rel="noopener">Open the app &nearr;</a>
              <a href="https://github.com/mo7morad/Academy-Stickies" class="btn btn-ghost" target="_blank" rel="noopener">View the repo &nearr;</a>
            </div>
          </div>
        </div>
      </div>

      <hr class="divider" />

      <div class="wrap work-item" id="academy" style="padding-top:3rem; padding-bottom:3rem;">
        <div class="grid">
          <div data-reveal>
            <div class="shots">
              <div>
                <PhoneMockup
                  size="sm"
                  src="/images/academy/numo-meal-entry.jpg"
                  alt="Numo meal-entry screen, a real screenshot from the app."
                />
                <p class="cap">Numo &mdash; meal entry screen, real screenshot</p>
              </div>
            </div>
          </div>
          <div data-reveal>
            <p class="section-eyebrow">05 &middot; Apple Developer Academy</p>
            <h2 class="section-title" style="margin-bottom:.9rem;">Five studio challenges in five weeks.</h2>
            <p class="p-lede">Before ECOdyssey, the Academy runs five one-week challenges. Numo is the strongest: a hand-rolled Claude vision client that reads a meal photo and returns structured nutrition data &mdash; temperature 0, on purpose, because structured data has to be reproducible, not creative.</p>
            <div class="kv-list">
              <div class="row"><span class="k">Client</span><span class="v mono">AnthropicMealAnalysisClient.swift</span></div>
              <div class="row"><span class="k">Error handling</span><span class="v mono">12-case typed error enum</span></div>
              <div class="row"><span class="k">Journey repo</span><span class="v mono">239 commits &middot; 118 Swift files</span></div>
            </div>
            <div class="quote-block">
              <code>temperature: 0</code><br />
              &ldquo;Structured nutrition data must be reproducible and schema-compliant, not creative.&rdquo; &mdash; in-code comment, Numo
            </div>
            <p class="foot" style="margin:-.6rem 0 1.3rem;">Same repo, same five weeks: Distill dropped a planned face-recognition feature after hitting Apple&rsquo;s Photos privacy limits and documented the pivot instead of hiding it; ContactsRemix still keeps both the hardcoded first pass and the data-driven refactor side by side.</p>
            <a href="https://github.com/mo7morad/My_Apple-Developer-Academy_Journey" class="btn btn-ghost" target="_blank" rel="noopener">View the journey repo &nearr;</a>
          </div>
        </div>
      </div>
    </section>

    <div class="aside">
      <div class="wrap">
        <p data-reveal><b>Beyond the code:</b> a repurposed laptop runs headless Debian under my desk &mdash; Nginx, managed entirely over SSH, running Pi-hole for network-wide ad blocking and Immich for self-hosted photo backup instead of a Google or iCloud plan. Same instinct as everything above, aimed at my own life: own the infrastructure instead of renting someone else&rsquo;s.</p>
      </div>
    </div>

    <footer class="site">
      <div class="wrap">
        <div class="footer-top">
          <div class="footer-cta">
            <h3>Open to backend or AI-product roles.</h3>
            <p>Remote or relocation &middot; Academy ends Dec 2026 &middot; Degree Aug 2027</p>
          </div>
          <div class="footer-links">
            <a href="mailto:momurad.business@gmail.com">momurad.business@gmail.com</a>
            <a href="https://github.com/mo7morad" target="_blank" rel="noopener">github.com/mo7morad</a>
            <a href="https://www.linkedin.com/in/momorad" target="_blank" rel="noopener">linkedin.com/in/momorad</a>
            <a href="https://apps.apple.com/app/id6766072256" target="_blank" rel="noopener">Trippé on the App Store</a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>&copy; Mohamed Morad</span>
          <span>Figures on this page are drawn from git history and file counts across the repositories they describe.</span>
        </div>
      </div>
    </footer>
  </main>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import Lenis from 'lenis';

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // In-page navigation: plain scrollIntoView, deliberately not routed through
    // Lenis. Lenis's job here is ambient wheel-scroll smoothing only — link
    // clicks use the native API directly so they never depend on a third-party
    // scroll engine's internal state to work.
    document.querySelectorAll('[data-scroll-to]').forEach((a) => {
      a.addEventListener('click', (e) => {
        const id = a.getAttribute('href');
        const target = id && document.querySelector(id);
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
      });
    });

    // Section reveals: IntersectionObserver + CSS transitions. No dependency on
    // GSAP/ScrollTrigger measurement timing, so sections can never get stuck
    // invisible if a library fails to load or a measurement goes stale.
    if (!reduced && 'IntersectionObserver' in window) {
      const laterReveals = Array.from(document.querySelectorAll('[data-reveal]')).filter(
        (el) => !el.closest('.hero')
      );
      laterReveals.forEach((el) => el.classList.add('io-pending'));
      const revealObserver = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.remove('io-pending');
              obs.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
      );
      laterReveals.forEach((el) => revealObserver.observe(el));

      const bars = document.querySelectorAll('.bar-fill');
      bars.forEach((el) => el.classList.add('bar-pending'));
      const barObserver = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.remove('bar-pending');
              obs.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.3 }
      );
      bars.forEach((el) => barObserver.observe(el));
    }

    if (!reduced) {
      gsap.registerPlugin(ScrollTrigger);

      const lenis = new Lenis({ duration: 1.05, smoothWheel: true });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => lenis.raf(time * 1000));
      gsap.ticker.lagSmoothing(0);

      const EASE_OUT = 'cubic-bezier(0.23, 1, 0.32, 1)';

      const words = gsap.utils.toArray('#hero-h1 .word');
      const heroReveals = Array.from(document.querySelectorAll('[data-reveal]')).filter((el) =>
        el.closest('.hero')
      );

      gsap.set(words, { opacity: 0, y: '0.6em' });
      gsap.set(heroReveals, { opacity: 0, y: 14 });
      gsap.set('.phone-wrap', { opacity: 0, x: 24, y: 0 });

      const tl = gsap.timeline({ defaults: { ease: EASE_OUT } });
      tl.to(words, { opacity: 1, y: 0, duration: 0.6, stagger: 0.045 })
        .to(heroReveals, { opacity: 1, y: 0, duration: 0.55, stagger: 0.08 }, '-=0.25')
        .to('.phone-wrap', { opacity: 1, x: 0, duration: 0.7 }, '-=0.5');

      // Phone parallax is the one justified scrubbed sequence — a missed frame
      // here just means the phone doesn't drift, never a hidden section.
      gsap.to('.phone-wrap .phone', {
        y: -22,
        ease: 'none',
        scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: 0.5 },
      });
      const refresh = () => ScrollTrigger.refresh();
      window.addEventListener('load', refresh);
      if (document.fonts?.ready) document.fonts.ready.then(refresh);
    }
  </script>
</Layout>
