---
import Layout from '../layouts/Layout.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
import * as si from 'simple-icons';

function brandIcon(icon: { hex: string; path: string; title: string }, color?: string) {
  return `<svg role="img" aria-label="${icon.title}" viewBox="0 0 24 24" fill="${color ?? `#${icon.hex}`}" xmlns="http://www.w3.org/2000/svg"><path d="${icon.path}"/></svg>`;
}

const LIGHT = '#e5e7eb'; // override for brand marks whose official color is near-black/invisible on this dark ground

const techList = [
  { icon: si.siTypescript, label: 'TypeScript' },
  { icon: si.siNodedotjs, label: 'Node.js' },
  { icon: si.siCloudflare, label: 'Cloudflare' },
  { icon: si.siPostgresql, label: 'PostgreSQL' },
  { icon: si.siSupabase, label: 'Supabase' },
  { icon: si.siDotnet, label: '.NET' },
  { icon: si.siSwift, label: 'Swift' },
  { icon: si.siApple, label: 'Apple', color: LIGHT },
  { icon: si.siGit, label: 'Git' },
  { icon: si.siGithub, label: 'GitHub', color: LIGHT },
  { icon: si.siHono, label: 'Hono' },
  { icon: si.siVitest, label: 'Vitest' },
  { icon: si.siDebian, label: 'Debian' },
  { icon: si.siNginx, label: 'NGINX' },
  { icon: si.siAstro, label: 'Astro' },
];

const specList = [
  { icon: si.siDebian, title: 'Headless Server', desc: 'A repurposed laptop, wiped and running headless Debian under my desk — driven entirely over SSH, no monitor, ever.' },
  { icon: si.siNginx, title: 'Reverse Proxy', desc: "Fronts every self-hosted service, TLS-terminated and configured by hand — not a managed dashboard." },
  { icon: si.siPihole, title: 'Network-Wide Ad Block', desc: 'DNS-level blocking for every device on the network, not just one browser.' },
  { icon: si.siImmich, title: 'Self-Hosted Photos', desc: 'Replaces a Google Photos or iCloud subscription with a photo library I actually control.' },
];

const badges = [
  { src: '/images/certificates/cert-01.png', n: '01', title: 'Foundations — Level 1' },
  { src: '/images/certificates/cert-10.png', n: '10', title: 'Object-Oriented Programming' },
  { src: '/images/certificates/cert-14.png', n: '14', title: 'C# — Level 1' },
  { src: '/images/certificates/cert-19.png', n: '19', title: 'Full Real Project — DVLD Capstone' },
  { src: '/images/certificates/cert-23.png', n: '23', title: 'Algorithms — Level 6' },
  { src: '/images/certificates/cert-25.png', n: '25', title: 'SOLID Principles' },
];

const iconPin = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-7.58 7-13a7 7 0 1 0-14 0c0 5.42 7 13 7 13Z"/><circle cx="12" cy="9" r="2.5"/></svg>`;
const iconMail = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>`;
const iconExternal = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>`;
const iconLinkedin = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><rect x="1" y="1" width="22" height="22" rx="4" fill="#0A66C2"/><path fill="#fff" d="M7.4 9.7h2.55v7.9H7.4zm1.28-1.1a1.48 1.48 0 1 1 0-2.96 1.48 1.48 0 0 1 0 2.96zm3.1 1.1h2.44v1.08h.03c.34-.64 1.17-1.32 2.41-1.32 2.58 0 3.06 1.7 3.06 3.9v4.24h-2.55v-3.76c0-.9-.02-2.05-1.25-2.05-1.25 0-1.44.98-1.44 1.98v3.83h-2.55z"/></svg>`;
const iconBriefcase = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18"/></svg>`;
const iconChip = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/></svg>`;
const iconBrackets = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m8 6-6 6 6 6M16 6l6 6-6 6"/></svg>`;
const iconServer = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="7" rx="1.5"/><rect x="3" y="13" width="18" height="7" rx="1.5"/><path d="M7 7.5h.01M7 16.5h.01"/></svg>`;
const iconAward = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6"/><path d="M9 14.5 7 22l5-3 5 3-2-7.5"/></svg>`;
const iconRocket = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 15s-1-5 4-9c4-3 9-3 9-3s0 5-3 9c-4 5-9 4-9 4Z"/><path d="m9 15-4 4M5 19l-.5.5"/><circle cx="14.5" cy="8.5" r="1.7"/></svg>`;
---

<Layout
  title="Mohamed Morad"
  description="Backend engineer, Apple Developer Academy Bali. Trippé — a travel app whose backend refuses to state a price it cannot trace to a quoted source."
>
  <div class="ambient" aria-hidden="true">
    <span class="b1"></span><span class="b2"></span><span class="b3"></span><span class="b4"></span>
  </div>

  <header class="nav glass">
    <div class="wrap nav-inner">
      <a href="#top" class="brand" data-scroll-to>
        <img src="/images/profile-avatar.jpg" alt="" />
        <span>morad</span>
      </a>
      <span id="clock" class="num"></span>
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <div class="wrap hero-grid" data-reveal>
        <div class="hero-photo-col">
          <div class="hero-photo">
            <img src="/images/profile-avatar.jpg" alt="Mohamed Morad" />
          </div>
          <p class="hero-loc"><Fragment set:html={iconPin} />Bali, Indonesia</p>
          <div class="hero-social">
            <a href="https://github.com/mo7morad" target="_blank" rel="noopener" aria-label="GitHub" set:html={brandIcon(si.siGithub, LIGHT)} />
            <a href="https://www.linkedin.com/in/momorad" target="_blank" rel="noopener" aria-label="LinkedIn" set:html={iconLinkedin} />
            <a href="https://apps.apple.com/app/id6766072256" target="_blank" rel="noopener" aria-label="Trippé on the App Store" set:html={brandIcon(si.siAppstore)} />
            <a href="mailto:momurad.business@gmail.com" aria-label="Email" set:html={iconMail} />
          </div>
        </div>
        <div>
          <h1 class="hero-name">Mohamed Morad</h1>
          <p class="hero-role">Backend Engineer &middot; TypeScript &middot; Cloudflare Workers &middot; SwiftUI</p>
          <p class="hero-bio">I spent twenty-one months on fundamentals before I shipped anything. Then I built Trippé &mdash; a travel app whose backend refuses to state a price it cannot trace to a quoted source. Backend, iOS client, cost engine: I wrote all three, alone.</p>
          <a href="mailto:momurad.business@gmail.com" class="btn glass glass-interactive" set:html={`${iconMail}Work With Me`} />
        </div>
      </div>
    </section>

    <section id="journey">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <span class="section-badge glass" set:html={iconBriefcase} />
          <h2 class="section-title" style="--grad-end:var(--cyan)">Professional Journey</h2>
        </div>
        <div class="section-line"></div>

        <div class="journey-list">
          <div class="journey-item" data-reveal>
            <div class="journey-head">
              <div>
                <h3>Apple Developer Academy, Bali</h3>
                <p class="journey-role">iOS &amp; Backend Engineer &middot; Cohort 2026</p>
              </div>
              <span class="journey-date">Mar 2026 &ndash; Present</span>
            </div>
            <p class="journey-desc">First Egyptian in the cohort, ~220 places from 5,000+ applicants. Built Trippé end to end and shipped it to the App Store in September 2026. The Academy runs through December 2026; the UII degree lands August 2027 &mdash; open to remote work or relocation now.</p>
            <ul>
              <li>Trippé: the pricing table rejects any row without a quoted source &mdash; a database constraint, not a suggestion</li>
              <li>ECOdyssey: wrote the belief-fusion engine for a waste-sorting kiosk; a 7-scenario test harness caught the legacy logic failing 3/7, mine failing 1/7</li>
              <li>ADA-Stickies: a magic-link note wall for the actual cohort, live since July 2026, still running</li>
              <li>Numo: a one-week studio build reading meal photos through Apple's on-device models at temperature 0, for reproducible structured output</li>
            </ul>
          </div>

          <div class="journey-item" data-reveal>
            <div class="journey-head">
              <div>
                <h3>Backend Fundamentals Roadmap</h3>
                <p class="journey-role">Self-Directed Curriculum</p>
              </div>
              <span class="journey-date">May 2024 &ndash; Feb 2026</span>
            </div>
            <p class="journey-desc">Twenty-one months of fundamentals before shipping anything real: C++, algorithms across six levels, OOP, data structures, C#, SQL and T-SQL, REST APIs, SOLID &mdash; 25 courses, 1,329 solved problems, 669 commits.</p>
            <ul>
              <li>A banking-system project rewritten four times, ending in full OOP with multi-currency exchange (~6,000 lines)</li>
              <li>Capstone: DVLD, a C# WinForms + SQL Server driving-license system &mdash; 134 files, 28,541 lines, strict 3-tier architecture, raw parameterized ADO.NET by choice</li>
            </ul>
          </div>

          <div class="journey-item" data-reveal>
            <div class="journey-head">
              <div>
                <h3>Scholarship to Indonesia</h3>
                <p class="journey-role">Informatics, Universitas Islam Indonesia</p>
              </div>
              <span class="journey-date">Aug 2023</span>
            </div>
            <p class="journey-desc">Left Egypt on a scholarship to study Informatics at UII &mdash; the decision that put fundamentals before shipping anything.</p>
          </div>

          <div class="journey-item" data-reveal>
            <div class="journey-head">
              <div>
                <h3>First Lines of Code</h3>
                <p class="journey-role">Cairo, Egypt</p>
              </div>
              <span class="journey-date">2023</span>
            </div>
            <p class="journey-desc">CS50 explains what a computer actually does. The first build &mdash; a Python/Tkinter download manager &mdash; loses its source: no git, no backup. <code class="mono">git init</code> has been the first thing typed on every project since.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="tech">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <span class="section-badge glass" set:html={iconChip} />
          <h2 class="section-title" style="--grad-end:var(--blue)">Tech Arsenal</h2>
        </div>
        <div class="section-line"></div>
        <div class="tech-grid" data-reveal>
          {techList.map((t) => (
            <div class="tech-tile glass glass-interactive">
              <Fragment set:html={brandIcon(t.icon, t.color)} />
              <span>{t.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="work">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <span class="section-badge glass" set:html={iconBrackets} />
          <h2 class="section-title" style="--grad-end:var(--cyan)">Featured Projects</h2>
        </div>
        <div class="section-line"></div>

        <div class="project-list">
          <article class="project-card glass" data-reveal>
            <div class="project-visual">
              <PhoneMockup size="sm" src="/images/trippe/destination-sao-miguel.jpg" alt="Trippé destination screen for São Miguel, Azores." />
              <PhoneMockup size="sm" src="/images/trippe/estimated-spending.jpg" alt="Trippé estimated cost breakdown screen." />
            </div>
            <div class="project-body">
              <div class="project-top">
                <h3>Trippé</h3>
                <div class="project-icons">
                  <Fragment set:html={brandIcon(si.siCloudflare)} />
                  <Fragment set:html={brandIcon(si.siTypescript)} />
                  <Fragment set:html={brandIcon(si.siSwift)} />
                </div>
              </div>
              <p>Trippé recommends a trip, then prices it against real harvested data before you see it. The pricing table has a hard constraint: a price row without a quoted source is discarded, not stored. I designed and built the Cloudflare Worker backend (599 commits, TypeScript, one runtime dependency), the SwiftUI client (250 commits, 47,075 lines), and the cost engine between them &mdash; alone, with 123 test files against 144 source files, and an on-device Apple Foundation Models fallback with a kill-switch.</p>
              <div class="project-links">
                <a href="https://apps.apple.com/app/id6766072256" class="btn glass glass-interactive" target="_blank" rel="noopener" set:html={`Live on the App Store${iconExternal}`} />
              </div>
            </div>
          </article>

          <article class="project-card glass" data-reveal>
            <div class="project-visual">
              <figure class="diagram-frame">
                <img src="/images/dvld/db-diagram.png" alt="DVLD database schema: thirteen tables including Licenses, Drivers, Applications, Tests, TestAppointments, People, and Users, with foreign-key relationships drawn between them." loading="lazy" />
              </figure>
            </div>
            <div class="project-body">
              <div class="project-top">
                <h3>Backend Fundamentals Roadmap</h3>
                <div class="project-icons">
                  <Fragment set:html={brandIcon(si.siDotnet)} />
                  <Fragment set:html={brandIcon(si.siGit)} />
                </div>
              </div>
              <p>Twenty-one months of self-curated fundamentals before I shipped anything: C++, algorithms across six levels, OOP, data structures, C#, SQL, REST APIs, SOLID &mdash; 25 courses, 1,329 solved problems, 669 commits. It ends in DVLD, a driving-license system built on C# WinForms and SQL Server in strict 3-tier architecture: 134 files, 28,541 lines, and data access that's raw, parameterized ADO.NET &mdash; no stored procedures, by choice. The schema above is drawn straight from the repo's own diagram.</p>
            </div>
          </article>

          <article class="project-card glass" data-reveal>
            <div class="project-visual">
              <div class="compare">
                <div class="bar-row">
                  <span class="bar-label">Legacy confidence-vote</span>
                  <div class="bar-track"><div class="bar-fill legacy" style="--target-width:43%"></div></div>
                  <span class="bar-val">3 / 7 confidently wrong</span>
                </div>
                <div class="bar-row">
                  <span class="bar-label">Belief engine (mine)</span>
                  <div class="bar-track"><div class="bar-fill belief" style="--target-width:14%"></div></div>
                  <span class="bar-val">1 / 7 confidently wrong</span>
                </div>
              </div>
            </div>
            <div class="project-body">
              <div class="project-top">
                <h3>ECOdyssey / Sortla</h3>
                <div class="project-icons">
                  <Fragment set:html={brandIcon(si.siSwift)} />
                  <Fragment set:html={brandIcon(si.siApple, LIGHT)} />
                </div>
              </div>
              <p>My role on a five-person team building a waste-sorting kiosk running on-device YOLOv8 via Core ML. I wrote the belief-fusion engine, the Private-Cloud-Compute second-opinion arbiter, and the test harness that graded both approaches against each other &mdash; replaying 7 fixed scenarios through the old confidence-vote logic and my belief engine. The old logic was wrong three times; mine was wrong once. The measurement found a real bug &mdash; it wasn't a demo of a passing test.</p>
            </div>
          </article>

          <article class="project-card glass" data-reveal>
            <div class="project-visual">
              <PhoneMockup size="sm" src="/images/stickies/gate.png" alt="Academy Stickies sign-in gate, a live production screenshot." />
            </div>
            <div class="project-body">
              <div class="project-top">
                <h3>ADA-Stickies</h3>
                <div class="project-icons">
                  <Fragment set:html={brandIcon(si.siCloudflare)} />
                  <Fragment set:html={brandIcon(si.siHono)} />
                  <Fragment set:html={brandIcon(si.siVitest)} />
                </div>
              </div>
              <p>A private wall of notes for my actual Academy cohort &mdash; magic-link email auth, so nobody needs a password I'd have to reset. Live since July 2026, still running: Cloudflare Pages, Hono, D1, R2, nine migrations tested with Vitest, 39 commits (33 mine).</p>
              <div class="project-links">
                <a href="https://academy-stickies.pages.dev" class="btn glass glass-interactive" target="_blank" rel="noopener" set:html={`Open the app${iconExternal}`} />
                <a href="https://github.com/mo7morad/Academy-Stickies" class="btn glass glass-interactive" target="_blank" rel="noopener" set:html={`${brandIcon(si.siGithub, LIGHT)}Source Code`} />
              </div>
            </div>
          </article>

          <article class="project-card glass" data-reveal>
            <div class="project-visual">
              <PhoneMockup size="sm" src="/images/academy/numo-meal-entry.jpg" alt="Numo meal-entry screen, a real screenshot from the app." />
            </div>
            <div class="project-body">
              <div class="project-top">
                <h3>Apple Developer Academy &mdash; Numo</h3>
                <div class="project-icons">
                  <Fragment set:html={brandIcon(si.siSwift)} />
                  <Fragment set:html={brandIcon(si.siApple, LIGHT)} />
                </div>
              </div>
              <p>Before ECOdyssey, the Academy runs five one-week studio challenges. Numo is the strongest: a hand-rolled Claude vision client that reads a meal photo and returns structured nutrition data at temperature 0, on purpose &mdash; structured data has to be reproducible, not creative. 239 commits, 118 Swift files, a 12-case typed error enum.</p>
              <div class="project-links">
                <a href="https://github.com/mo7morad/My_Apple-Developer-Academy_Journey" class="btn glass glass-interactive" target="_blank" rel="noopener" set:html={`${brandIcon(si.siGithub, LIGHT)}View the journey repo`} />
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="beyond">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <span class="section-badge glass" set:html={iconServer} />
          <h2 class="section-title" style="--grad-end:var(--blue)">Beyond the Code</h2>
        </div>
        <div class="section-line"></div>
        <p class="section-intro" data-reveal>A repurposed laptop runs headless Debian under my desk, managed entirely over SSH. Same instinct as everything above, aimed at my own life: own the infrastructure instead of renting someone else's.</p>
        <div class="spec-grid" data-reveal>
          {specList.map((s) => (
            <div class="spec-card glass">
              <span class="spec-icon" set:html={brandIcon(s.icon)} />
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="achievements">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <span class="section-badge glass" set:html={iconAward} />
          <h2 class="section-title" style="--grad-end:var(--cyan)">Certificates &amp; Receipts</h2>
        </div>
        <div class="section-line"></div>
        <p class="section-intro" data-reveal>Six of the twenty-five course completions behind the fundamentals roadmap above &mdash; issued by ProgrammingAdvices, the platform the curriculum was built on.</p>
        <div class="badge-grid" data-reveal>
          {badges.map((b) => (
            <div class="badge-card glass">
              <img src={b.src} alt={`Certificate of attendance, course ${b.n}: ${b.title}`} loading="lazy" />
              <div class="badge-cap"><b>{b.n} &middot; {b.title}</b>ProgrammingAdvices &middot; Certificate of Attendance</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="contact">
      <div class="wrap">
        <div class="cta-block glass" data-reveal>
          <span class="section-badge glass" style="margin:0 auto 1rem;" set:html={iconRocket} />
          <h2 class="section-title" style="--grad-end:var(--blue)">Open to What's Next</h2>
          <p>Backend or AI-product roles, remote or relocation. The Academy runs through December 2026; the UII degree lands August 2027 &mdash; available for conversations now.</p>
          <a href="mailto:momurad.business@gmail.com" class="btn glass glass-interactive" set:html={`${iconMail}Work With Me`} />
        </div>
      </div>
    </section>

    <footer class="site">
      <div class="wrap">
        <div class="footer-links" style="flex-direction:row; flex-wrap:wrap; gap:1.6rem; margin-bottom:1.6rem;">
          <a href="mailto:momurad.business@gmail.com">momurad.business@gmail.com</a>
          <a href="https://github.com/mo7morad" target="_blank" rel="noopener">github.com/mo7morad</a>
          <a href="https://www.linkedin.com/in/momorad" target="_blank" rel="noopener">linkedin.com/in/momorad</a>
          <a href="https://apps.apple.com/app/id6766072256" target="_blank" rel="noopener">Trippé on the App Store</a>
        </div>
        <div class="footer-bottom">
          <span>&copy; Mohamed Morad</span>
          <span>Figures on this page are drawn from git history and file counts across the repositories they describe.</span>
        </div>
      </div>
    </footer>
  </main>

  <script>
    import Lenis from 'lenis';

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll('[data-scroll-to]').forEach((a) => {
      a.addEventListener('click', (e) => {
        const id = a.getAttribute('href');
        const target = id && document.querySelector(id);
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
      });
    });

    const clockEl = document.getElementById('clock');
    if (clockEl) {
      const tick = () => {
        clockEl.textContent = new Date().toLocaleTimeString('en-GB', {
          timeZone: 'Asia/Makassar',
          hour12: false,
        });
      };
      tick();
      setInterval(tick, 1000);
    }

    // Reveals default to visible in CSS; JS only opts sections into the
    // fade-up by adding .io-pending, so a JS failure never hides content.
    if (!reduced && 'IntersectionObserver' in window) {
      const reveals = Array.from(document.querySelectorAll('[data-reveal]'));
      reveals.forEach((el) => el.classList.add('io-pending'));
      const revealObserver = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.remove('io-pending');
              obs.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
      );
      reveals.forEach((el) => revealObserver.observe(el));

      const bars = document.querySelectorAll('.bar-fill');
      bars.forEach((el) => el.classList.add('bar-pending'));
      const barObserver = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.remove('bar-pending');
              obs.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.3 }
      );
      bars.forEach((el) => barObserver.observe(el));
    }

    if (!reduced) {
      const lenis = new Lenis({ duration: 1.05, smoothWheel: true });
      const raf = (time: number) => {
        lenis.raf(time);
        requestAnimationFrame(raf);
      };
      requestAnimationFrame(raf);
    }
  </script>
</Layout>
